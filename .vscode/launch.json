{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run GUI (External Terminal via Bootstrap)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/run_gui_bootstrap.py",
      "console": "externalTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false,
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Attach GUI (debugpy:5678)",
      "type": "python",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "justMyCode": false
    }
  ]
}
