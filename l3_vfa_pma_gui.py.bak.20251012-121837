    def export_now(self):
        try:
            if not getattr(self, "_last", None):
                messagebox.showwarning("Uyarı", "Önce bir analiz çalıştırın.")
                return

            out_root = filedialog.askdirectory(title="QA paket çıkış klasörü seçin")
            if not out_root:
                return

            res = self._last.get("res", {})
            overlay = self._last.get("overlay", None)
            case_id = str(res.get("ID", "case"))
            out_dir = Path(out_root) / f"{case_id}_QA_{time.strftime('%Y%m%d_%H%M%S')}"
            out_dir.mkdir(parents=True, exist_ok=True)

            if overlay is not None and cv2 is not None:
                cv2.imwrite(str(out_dir / f"{case_id}_overlay.png"), overlay)

            vfa_cut = int(res.get('VFA_OBESITY_CUTOFF', 100)) if 'VFA_OBESITY_CUTOFF' in res else 100
            vfa_key = f"VFA≥{vfa_cut}cm2"
            ratio_val = res.get("VFA_PMA_ratio", "")
            pmi_val = res.get("PMI_cm2_per_m2", "")
            ratio_str = "NA" if ratio_val in ("", None) else f"{ratio_val:.2f}"
            pmi_str = "NA" if pmi_val in ("", None) else f"{pmi_val:.2f}"

            lines = [
                "=== RESULT @ MINI GUI ===",
                f"ID: {res.get('ID','')} | Sex: {res.get('Sex','')} | Height(m): {res.get('Height_m','')}",
                f"PMA: {res.get('PMA_mm2',0):.1f} mm²   VFA: {res.get('VFA_mm2',0):.1f} mm² ({res.get('VFA_cm2',0):.1f} cm²)",
                f"VFA/PMA: {ratio_str}   PMI: {pmi_str} cm²/m²",
                f"Sarcopenia(PMI<cutoff): {res.get('Sarcopenia(PMI<cutoff)',0)}  {vfa_key}: {res.get(vfa_key, res.get('Obesity_VFA_based',0))}  SO: {res.get('SO_Flag(1=yes)',0)}"
            ]
            (out_dir / f"{case_id}_results.txt").write_text("\n".join(lines), encoding="utf-8")
            (out_dir / f"{case_id}_results.json").write_text(json.dumps(res, ensure_ascii=False, indent=2), encoding="utf-8")

            messagebox.showinfo("Tamam", f"QA paket hazır: {out_dir}")
        except Exception as e:
            messagebox.showerror("Hata", f"Dışa aktarım başarısız: {e}")

