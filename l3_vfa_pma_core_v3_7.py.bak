# =========================
# Ayar yükleme
# =========================
def load_settings(root_dir: Path):
    """settings.json varsa CFG’yi override eder."""
    sp = (root_dir / "settings.json")
    if sp.exists():
        try:
            data = json.loads(sp.read_text(encoding="utf-8"))
            for k, v in data.items():
                CFG[k] = v
            print(f"[INFO] settings.json yüklendi: {sp}")
        except Exception as e:
            print(f"[WARN] settings.json okunamadı: {e}")
        return res, overlay

# =========================
# DICOM / temel yardımcılar
# =========================
def load_hu(ds):
    arr = ds.pixel_array.astype(np.float32)
    slope = float(getattr(ds, "RescaleSlope", 1.0))
    inter = float(getattr(ds, "RescaleIntercept", 0.0))
    return arr * slope + inter

def pixel_spacing(ds) -> Tuple[float, float]:
    sp = getattr(ds, "PixelSpacing", None)
    if sp is None or len(sp) < 2:
        raise ValueError("PixelSpacing eksik.")
    return float(sp[0]), float(sp[1])

def px_area_mm2(ds) -> float:
    sy, sx = pixel_spacing(ds)
    return sy * sx

def mm_to_px(ds, mm: float) -> int:
    sy, sx = pixel_spacing(ds)
    s = (sy + sx) / 2.0
    return max(1, int(round(mm / max(1e-6, s))))

def area_px_from_mm2(ds, mm2: float) -> int:
    sy, sx = pixel_spacing(ds)
    return int(round(mm2 / (sy * sx + 1e-9)))

def hu_mask(hu, lo, hi):
    return ((hu >= lo) & (hu <= hi)).astype(np.uint8) * 255

def normalize8(hu, lo=-300, hi=300):
    img = np.clip(hu, lo, hi).astype(np.float32)
    return cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

def centroid(mask):
    m = (mask > 0).astype(np.uint8)
    if m.sum() == 0:
        return None
    M = cv2.moments(m)
    if M["m00"] == 0:
        return None
    return (M["m10"]/M["m00"], M["m01"]/M["m00"])

# =========================
# PNG ↔ DICOM registration (opsiyonel)
# =========================
def register_png_to_dicom(png_gray, dicom_gray):
    try:
        orb = cv2.ORB_create(nfeatures=CFG["PNG_REG_MAX_FEAT"], fastThreshold=5)
        k1, d1 = orb.detectAndCompute(png_gray, None)
        k2, d2 = orb.detectAndCompute(dicom_gray, None)
        if d1 is None or d2 is None or len(k1) < 20 or len(k2) < 20:
            return None
        bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=False)
        matches = bf.knnMatch(d1, d2, k=2)
        good = [m for m, n in matches if m.distance < 0.75 * n.distance]
        if len(good) < CFG["PNG_REG_GOOD_MATCH"]:
            return None
        src = np.float32([k1[m.queryIdx].pt for m in good]).reshape(-1, 1, 2)
        dst = np.float32([k2[m.trainIdx].pt for m in good]).reshape(-1, 1, 2)
        M, inliers = cv2.estimateAffine2D(src, dst, ransacReprojThreshold=3.0, confidence=0.99)
        if M is None or (inliers is not None and inliers.sum() < CFG["PNG_REG_MIN_INLIERS"]):
            return None
        return M
    except Exception:
        return None

def warp_png_with_affine(png_gray, shape_hw, M):
    h, w = shape_hw
    return cv2.warpAffine(png_gray, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)

# =========================
# Segmentasyon adımları
# =========================
def body_mask_from_hu(hu):
    img8 = normalize8(hu, -300, 300)
    img8 = cv2.GaussianBlur(img8, (7, 7), 0)
    _, th = cv2.threshold(img8, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    if np.mean(img8[th > 0]) < np.mean(img8[th == 0]):
        th = 255 - th
    th = cv2.morphologyEx(th, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 2)
    th = cv2.morphologyEx(th, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    return th

def vertebra_body_mask(hu):
    h, w = hu.shape
    cx, cy = w // 2, h // 2
    seed = hu_mask(hu, *CFG["HU_BONE_SEED"])
    cand = hu_mask(hu, *CFG["HU_BONE_CAND"])
    num, L, S, C = cv2.connectedComponentsWithStats(seed, 8)
    if num <= 1:
        return np.zeros_like(seed)
    minA, maxA = 0.001 * (h*w), 0.06 * (h*w)
    best, sc = 0, -1e9
    for lbl in range(1, num):
        x, y, ww, hh, a = S[lbl]
        if not (minA <= a <= maxA):
            continue
        mx, my = C[lbl]
        dist = math.hypot(mx - cx, my - cy)
        comp = (L == lbl).astype(np.uint8) * 255
        edges = cv2.Canny(comp, 0, 1)
        perim = float(np.count_nonzero(edges)) + 1e-6
        circ = 4.0 * np.pi * a / (perim * perim)
        s = a - 3.0 * dist + 5000.0 * circ
        if s > sc:
            best, sc = lbl, s
    if best == 0:
        return np.zeros_like(seed)
    seed_sel = (L == best).astype(np.uint8) * 255
    grown = cv2.bitwise_and(cand, cv2.dilate(seed_sel, np.ones((15, 15), np.uint8), 1))
    grown = cv2.morphologyEx(grown, cv2.MORPH_CLOSE, np.ones((11, 11), np.uint8), 2)
    grown = cv2.morphologyEx(grown, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    num2, L2, S2, _ = cv2.connectedComponentsWithStats(grown, 8)
    if num2 <= 1:
        return np.zeros_like(grown)
    best2, sc2 = 0, -1e9
    for lbl in range(1, num2):
        x, y, ww, hh, a = S2[lbl]
        mx, my = cv2.connectedComponentsWithStats(grown, 8)[3][lbl]
        dist = math.hypot(mx - cx, my - cy)
        s = a - 2.0 * dist
        if s > sc2:
            best2, sc2 = lbl, s
    vb = (L2 == best2).astype(np.uint8) * 255
    vb = cv2.morphologyEx(vb, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 1)
    return vb

def gradient_mask_u8(img8, ring, strength=0.85):
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    vals = mag[ring > 0]
    thr = np.percentile(vals, 100*strength) if vals.size >= 50 else np.percentile(mag, 90)
    g = (mag >= thr).astype(np.uint8) * 255
    return cv2.morphologyEx(g, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8), 1)

def refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=None):
    h, w = hu.shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    img8 = normalize8(hu, -200, 300)
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    thr = np.percentile(mag, CFG["FASCIA_EDGE_Q"]*100.0)
    wall_edges = (mag >= thr).astype(np.uint8)*255
    if png_edges is not None:
        wall_edges = cv2.bitwise_or(wall_edges, png_edges)
    wall_edges = cv2.bitwise_and(wall_edges, body_cc)

    gap = mm_to_px(ds, 6.0)
    wall_edges = cv2.morphologyEx(wall_edges, cv2.MORPH_CLOSE, np.ones((gap, gap), np.uint8), 1)

    wall_barrier = cv2.dilate(wall_edges, np.ones((3, 3), np.uint8), 1)
    barrier = cv2.bitwise_or(wall_barrier, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner2 = (tmp2 == 128).astype(np.uint8) * 255
    inner2 = cv2.bitwise_and(inner2, body_cc)
    inner2 = cv2.morphologyEx(inner2, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)
    return inner2, wall_edges

def inner_abdomen_via_wall(hu, ds, png_gray=None, png_band_mm=25, height_band_mm=80):
    body = body_mask_from_hu(hu)
    h, w = hu.shape
    vb = vertebra_body_mask(hu)
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    # body_cc (merkezle aynı komponent)
    num_b, Lb, _, _ = cv2.connectedComponentsWithStats((body > 0).astype(np.uint8), 8)
    body_cc = np.zeros_like(body)
    if num_b > 1:
        lbl = Lb[cy, cx]
        if lbl != 0:
            body_cc[Lb == lbl] = 255
    if body_cc.sum() == 0:
        body_cc = body

    # PNG kenarı (opsiyonel)
    png_edges = np.zeros_like(body_cc)
    if png_gray is not None:
        dicom8 = normalize8(hu, -200, 300)
        M = register_png_to_dicom(png_gray, dicom8)
        if M is not None:
            png_gray = warp_png_with_affine(png_gray, hu.shape, M)
        g = cv2.GaussianBlur(png_gray, (3, 3), 0)
        gx = cv2.Sobel(g, cv2.CV_32F, 1, 0, 3)
        gy = cv2.Sobel(g, cv2.CV_32F, 0, 1, 3)
        mag = cv2.magnitude(gx, gy)
        thr = np.percentile(mag, 88)
        full = (mag >= thr).astype(np.uint8) * 255
        band25 = mm_to_px(ds, png_band_mm)
        y1, y2 = max(0, cy - band25), min(h, cy + band25)
        png_edges[y1:y2, :] = full[y1:y2, :]
        png_edges = cv2.bitwise_and(png_edges, body_cc)

    # HU+gradient ile duvar
    img8 = normalize8(hu, -200, 300)
    sob = gradient_mask_u8(img8, body_cc, CFG["GRAD_STRENGTH_BASE"])
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    wall0 = cv2.bitwise_or(muscle, sob)
    wall0 = cv2.bitwise_or(wall0, png_edges)
    wall0 = cv2.bitwise_and(wall0, body_cc)

    # kaba inner
    wall = cv2.morphologyEx(wall0, cv2.MORPH_CLOSE,
                            np.ones((2*mm_to_px(ds, 5)+1, )*2, np.uint8), 1)
    wall = cv2.dilate(wall, np.ones((2*mm_to_px(ds, 2)+1, )*2, np.uint8), 1)
    barrier = cv2.bitwise_or(wall, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner = (tmp2 == 128).astype(np.uint8) * 255
    inner = cv2.bitwise_and(inner, body_cc)

    # aktif kontur rafinesi
    inner, wall_ref = refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=png_edges)

    # yükseklik bandı (L3 civarı)
    bandH = mm_to_px(ds, height_band_mm)
    y1, y2 = max(0, cy - bandH), min(h, cy + bandH)
    height_mask = np.zeros_like(inner); height_mask[y1:y2, :] = 255
    inner = cv2.bitwise_and(inner, height_mask)
    inner = cv2.morphologyEx(inner, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)

    # NOT: VFA düşmesin diye inner erozyonu UYGULAMIYORUZ (önceden kaldırıldı)
    return inner, wall_ref, vb, (cx, cy)

# =========================
# HU adaptasyonu / şekil skorları
# =========================
def adaptive_muscle_mask(hu, ring, base_range, fallback_range):
    vals = hu[ring > 0]
    vals = vals[(vals > fallback_range[0]) & (vals < fallback_range[1])]
    if vals.size >= 200:
        p10, p95 = np.percentile(vals, [10, 95])
        lo = max(fallback_range[0], min(base_range[0], p10 - 15))
        hi = min(fallback_range[1], max(base_range[1], p95 + 15))
        lo2 = max(fallback_range[0], min(lo, hi - 5))
        hi2 = min(fallback_range[1], max(hi, lo2 + 5))
        return hu_mask(hu, lo2, hi2), (float(lo2), float(hi2))
    return hu_mask(hu, *base_range), base_range

def shape_orientation_scores(comp_mask):
    m = (comp_mask > 0).astype(np.uint8)
    if cv2.countNonZero(m) == 0:
        return 0.0, 0.0, 0.0, 0.0
    cnts, _ = cv2.findContours(m, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return 0.0, 0.0, 0.0, 0.0
    cnt = max(cnts, key=cv2.contourArea)
    area = float(cv2.contourArea(cnt))
    hull = cv2.convexHull(cnt)
    hull_area = float(cv2.contourArea(hull)) + 1e-6
    convexity = max(0.0, min(1.0, area / hull_area))
    if len(cnt) >= 5:
        (_cx, _cy), (MA, ma), angle = cv2.fitEllipse(cnt)
        a = max(MA, ma) / 2.0
        b = max(1e-6, min(MA, ma) / 2.0)
        ecc = math.sqrt(max(0.0, 1.0 - (b*b)/(a*a)))
        axis_deg = float(angle)
    else:
        M = cv2.moments(cnt)
        if M["mu20"] + M["mu02"] == 0:
            ecc = 0.0; axis_deg = 0.0
        else:
            ang = 0.5 * math.atan2(2 * M["mu11"], (M["mu20"] - M["mu02"]))
            axis_deg = abs(np.degrees(ang))
            lam1 = (M["mu20"] + M["mu02"]) / 2 + math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            lam2 = (M["mu20"] + M["mu02"]) / 2 - math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            ecc = math.sqrt(max(0.0, 1.0 - (lam2+1e-6)/(lam1+1e-6)))
    # yataya yakınlık
    delta = min(abs(axis_deg - 0.0), abs(axis_deg - 180.0))
    axis_ok = 1.0 if delta <= CFG["PSOAS_AXIS_MAX_DEG"] else max(0.0, 1.0 - (delta - CFG["PSOAS_AXIS_MAX_DEG"])/CFG["PSOAS_AXIS_MAX_DEG"])
    ecc_ok = min(1.0, max(0.0, (ecc - CFG["PSOAS_SHAPE_MIN_ECC"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_ECC"] + 1e-6)))
    conv_ok = min(1.0, max(0.0, (convexity - CFG["PSOAS_SHAPE_MIN_CONVEXITY"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_CONVEXITY"] + 1e-6)))
    shape_score = 0.45*ecc_ok + 0.25*conv_ok + 0.30*axis_ok
    return float(ecc), float(convexity), float(axis_ok*100.0), float(shape_score)

# =========================
# (YENİ) PSOAS Yardımcıları + Bulucu
# =========================
def posterior_exclusion_mask(hu_shape, vb, ds, angle_right=(0,90), angle_left=(90,180)):
    """Posterior 180–360°’yi kapat, sağ/sol sektörleri üret."""
    h, w = hu_shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = cen
    yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
    dx, dy = xx - cx, cy - yy
    ang = (np.degrees(np.arctan2(dy, dx)) + 360.0) % 360.0
    R = ((ang >= angle_right[0]) & (ang <= angle_right[1])).astype(np.uint8)*255
    L = ((ang >= angle_left[0])  & (ang <= angle_left[1])).astype(np.uint8)*255
    POST = ((ang >= 180) & (ang < 360)).astype(np.uint8)*255
    return R, L, POST

def mediality_score(comp_mask, vb, ds, target_mm=10.0):
    inv_v = cv2.bitwise_not(vb)
    dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
    md = float(dist[comp_mask > 0].mean()) if cv2.countNonZero(comp_mask) else 1e9
    tgt_px = mm_to_px(ds, target_mm)
    if md <= 0 or tgt_px <= 0:
        return 0.0, md
    sc = max(0.0, min(1.0, (tgt_px / (md + 1e-6))))
    return sc, md

def refine_small_active_contour(mask):
    if mask is None or cv2.countNonZero(mask) == 0:
        return mask
    k = np.ones((3,3), np.uint8)
    out = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k, iterations=1)
    out = cv2.morphologyEx(out,  cv2.MORPH_OPEN,  k, iterations=1)
    return out

def find_psoas_inside(hu, ds, inner, vertebra,
                      ring_inner_mm=6.0, ring_outer_mm=22.0,
                      grad_strength=0.85,
                      min_area_mm2=150.0, max_area_mm2=2000.0):
    """
    Vertebranın anteromedialinde, fasya İÇİNDE psoas arar:
    - Sağ: 0–90°, Sol: 90–180°
    - Posterior 180–360° tamamen dışlanır
    - Vertebraya yakınlık (mediality), HU, şekil ve eksen kısıtları
    """
    h, w = hu.shape
    cen = centroid(vertebra)
    if cen is None:
        return np.zeros_like(vertebra), {"reason": "vertebra_not_found"}

    # Fasya içi halka
    i_px = mm_to_px(ds, ring_inner_mm)
    o_px = mm_to_px(ds, ring_outer_mm)
    dil_in  = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*i_px+1, 2*i_px+1)), 1)
    dil_out = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*o_px+1, 2*o_px+1)), 1)
    ring = cv2.bitwise_and(cv2.subtract(dil_out, dil_in), inner)

    # Sektörler
    Rsec, Lsec, POST = posterior_exclusion_mask(hu.shape, vertebra, ds)
    ring = cv2.bitwise_and(ring, cv2.bitwise_not(POST))

    # Aday kas maskesi
    img8 = normalize8(hu, -200, 300)
    gmask  = gradient_mask_u8(img8, ring, grad_strength)
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    base = cv2.bitwise_and(muscle, ring)
    base = cv2.bitwise_and(base, gmask)

    # Kemik + vertebra buffer dışı
    bone_ex = hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    base = cv2.bitwise_and(base, cv2.bitwise_not(bone_ex))
    base = cv2.bitwise_and(base, cv2.bitwise_not(vbuf))

    # Sağ/sol adaylar
    R_cand = cv2.bitwise_and(base, Rsec)
    L_cand = cv2.bitwise_and(base, Lsec)

    # Alan sınırları
    min_px = area_px_from_mm2(ds, min_area_mm2)
    max_px = area_px_from_mm2(ds, max_area_mm2)

    def pick_best(cand_mask):
        m = (cand_mask > 0).astype(np.uint8)
        num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
        best = {"mask": None, "area": 0, "md": 1e9, "shape": -1, "stats": None, "score": -1.0,
                "ecc":0.0, "conv":0.0, "axis_pct":0.0}
        if num <= 1:
            return best

        inv_v = cv2.bitwise_not(vertebra)
        dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)

        for lbl in range(1, num):
            comp = (L == lbl).astype(np.uint8)
            a = int(S[lbl, cv2.CC_STAT_AREA])
            if a < min_px or a > max_px:
                continue

            vals = hu[comp > 0]
            mean_hu, std_hu = float(vals.mean()), float(vals.std())
            if not (-10 <= mean_hu <= 80 and std_hu >= 8.0):
                continue

            # Medial yakınlık
            med_sc, md = mediality_score(comp, vertebra, ds, target_mm=10.0)
            if md < mm_to_px(ds, 3.0):  # vertebraya yapışık olmasın
                continue

            # Şekil/eksen
            ecc, conv, axis_pct, shape_sc = shape_orientation_scores(comp)
            axis_ok = axis_pct/100.0
            if axis_ok <= 0.2:
                continue

            # HU stabilitesi (yumuşak kriter)
            hu_stab = min(1.0, std_hu/15.0) * 0.5 + (1.0 - abs(mean_hu-40)/80.0)*0.5
            hu_stab = max(0.0, min(1.0, hu_stab))

            score = 0.45*med_sc + 0.35*shape_sc + 0.20*hu_stab
            if score > best["score"]:
                best.update({
                    "mask": comp*255, "area": a, "md": md, "shape": shape_sc,
                    "stats": (mean_hu, std_hu), "score": score,
                    "ecc": ecc, "conv": conv, "axis_pct": axis_pct
                })

        if best["mask"] is not None:
            best["mask"] = refine_small_active_contour(best["mask"])
        return best

    Rbest = pick_best(R_cand)
    Lbest = pick_best(L_cand)

    # --- Fallback: Eğer her iki taraf da bulunamadıysa, kriterleri gevşeterek tekrar dene
    if Rbest["mask"] is None and Lbest["mask"] is None:
        HU_SOFT = (-20, 100)
        base_soft = cv2.bitwise_and(hu_mask(hu, *HU_SOFT), ring)
        base_soft = cv2.bitwise_and(base_soft, cv2.bitwise_not(hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])))
        vbuf2 = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                        (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
        base_soft = cv2.bitwise_and(base_soft, cv2.bitwise_not(vbuf2))

        R_cand2 = cv2.bitwise_and(base_soft, Rsec)
        L_cand2 = cv2.bitwise_and(base_soft, Lsec)

        def pick_loose(cand_mask):
            m = (cand_mask > 0).astype(np.uint8)
            num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
            best = {"mask": None, "area": 0, "md": 1e9, "score": -1.0}
            if num <= 1:
                return best
            inv_v = cv2.bitwise_not(vertebra)
            dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
            min_px2 = area_px_from_mm2(ds, 80.0)
            max_px2 = area_px_from_mm2(ds, 3500.0)
            for lbl in range(1, num):
                comp = (L == lbl).astype(np.uint8)
                a = int(S[lbl, cv2.CC_STAT_AREA])
                if a < min_px2 or a > max_px2:
                    continue
                vals = hu[comp > 0]
                mean_hu, std_hu = float(vals.mean()), float(vals.std())
                if not (-20 <= mean_hu <= 100 and std_hu >= 5.0):
                    continue
                med_sc, md = mediality_score(comp, vertebra, ds, target_mm=12.0)
                if md < mm_to_px(ds, 2.0):
                    continue
                score = med_sc + std_hu/20.0
                if score > best["score"]:
                    best.update({"mask": comp*255, "area": a, "md": md, "score": score})
            if best["mask"] is not None:
                best["mask"] = refine_small_active_contour(best["mask"])
            return best

        Rbest2 = pick_loose(R_cand2)
        Lbest2 = pick_loose(L_cand2)
        if Rbest2["mask"] is not None: Rbest = Rbest2
        if Lbest2["mask"] is not None: Lbest = Lbest2

    psoas = np.zeros_like(vertebra)
    if Rbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Rbest["mask"])
    if Lbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Lbest["mask"])

    # Fasya içi ve vertebra buffer dışı garantisi
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    psoas = cv2.bitwise_and(psoas, inner)
    psoas = cv2.bitwise_and(psoas, cv2.bitwise_not(vbuf))

    dbg = {
        "R_area_px": int(Rbest.get("area", 0) or 0),
        "L_area_px": int(Lbest.get("area", 0) or 0),
        "R_mean_dist": float(Rbest.get("md", 0.0) or 0.0),
        "L_mean_dist": float(Lbest.get("md", 0.0) or 0.0),
        "R_stats": Rbest.get("stats"),
        "L_stats": Lbest.get("stats"),
        "Rshape": float(Rbest.get("shape", -1.0) or -1.0),
        "Lshape": float(Lbest.get("shape", -1.0) or -1.0),
        "R_score": float(Rbest.get("score", -1.0) or -1.0),
        "L_score": float(Lbest.get("score", -1.0) or -1.0)
    }
    return psoas, dbg

# =========================
# Ölçüm / Overlay
# =========================

def vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=None):
    """
    VFA: her zaman FASYA-İÇİ yağ alanı (SFA HARİÇ)
    PMA: psoas_mask piksel alanı
    Debug: AO_VFA_total_mm2 (iç+dış), AO_SFA_mm2 (fasya-dışı)
    """
    import numpy as np, cv2

    # HU aralığı
    fr = fat_range if fat_range else globals().get('HU_FAT', (-190, -30))

    fat_mask = hu_mask(hu, *fr)                  # tüm yağ
    vfa_mask_inside = cv2.bitwise_and(fat_mask, inner)         # FASYA-İÇİ yağ (DOĞRU VFA)
    vfa_mask_total  = fat_mask                                  # iç + dış (kontrol)
    sfa_mask        = cv2.bitwise_and(fat_mask, cv2.bitwise_not(inner))  # sadece debug

    # piksel alan → mm²
    py = getattr(ds, "PixelSpacing", [1,1])
    pxA = float(py[0]) * float(py[1])

    VFA_px_inside = int(cv2.countNonZero(vfa_mask_inside))
    VFA_px_total  = int(cv2.countNonZero(vfa_mask_total))
    SFA_px        = int(cv2.countNonZero(sfa_mask))
    PMA_px        = int(cv2.countNonZero(psoas_mask))

    VFA_mm2 = float(VFA_px_inside * pxA)   # yalnızca fasya-içi → raporlanacak VFA
    PMA_mm2 = float(PMA_px * pxA)

    # Debug kayıtları (çağıran taraf "dbg" dict ekliyor ise oraya yazacağız)
    try:
        if 'dbg' in locals() and isinstance(dbg, dict):
            dbg["AO_VFA_inside_mm2"] = float(VFA_px_inside * pxA)
            dbg["AO_VFA_total_mm2"]  = float(VFA_px_total  * pxA)
            dbg["AO_SFA_mm2"]        = float(SFA_px        * pxA)
    except Exception:
        pass

    return VFA_mm2, PMA_mm2


def build_overlay(hu, inner, vertebra, vfa_mask, psoas_mask):
    base = normalize8(hu, -200, 300)
    base = cv2.cvtColor(base, cv2.COLOR_GRAY2BGR)
    base[inner == 0] = (base[inner == 0] * 0.25).astype(np.uint8)
    # VFA: yeşil, Psoas: sarı, Vertebra: kırmızı
    for (m, col, al) in ((vfa_mask, (0,255,0), 0.35), (psoas_mask, (0,255,255), 0.55), (vertebra, (255,0,0), 0.35)):
        if m is None: continue
        m_in = cv2.bitwise_and(m, inner)
        a = ((m_in > 0).astype(np.float32)) * al
        colimg = np.full_like(base, col, np.uint8)
        base = (base * (1 - a[..., None]) + colimg * a[..., None]).astype(np.uint8)
    # kontur çiz
    for m, c in ((vfa_mask, (0,255,0)), (psoas_mask, (0,255,255))):
        m_in = cv2.bitwise_and(m, inner)
        cnts, _ = cv2.findContours((m_in > 0).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cv2.drawContours(base, cnts, -1, c, 2, lineType=cv2.LINE_AA)
    return base

# =========================
# Ana dış API
# =========================
def run_case(dcm_path: Path, height_cm: float, sex: str, png_path: Optional[Path] = None) -> Tuple[Metrics, Optional[np.ndarray]]:
    """
    GUI’nin çağırdığı tek giriş noktası.
    DICOM zorunlu, PNG opsiyonel (aynı kesitse registration faydalı).
    """
    dcm_path = Path(dcm_path)
    ds = pydicom.dcmread(str(dcm_path))
    hu = load_hu(ds)

    png_gray = None
    if png_path and Path(png_path).exists():
        png_gray = cv2.imread(str(png_path), cv2.IMREAD_GRAYSCALE)

    # Fasya içi alan + vertebra
    inner, wall_ref, vb, _ = inner_abdomen_via_wall(hu, ds, png_gray=png_gray, png_band_mm=25, height_band_mm=80)

    # Psoas (anteromedial, posterior dışlama)
    psoas_mask, _dbg = find_psoas_inside(
        hu, ds, inner, vb,
        ring_inner_mm=CFG["RING_INNER_MM_BASE"],
        ring_outer_mm=CFG["RING_OUTER_MM_BASE"],
        grad_strength=CFG["GRAD_STRENGTH_BASE"],
        min_area_mm2=CFG["MIN_PSOAS_AREA_MM2_BASE"],
        max_area_mm2=CFG["MAX_PSOAS_AREA_MM2_BASE"]
    )

    # VFA/PMA
    VFA_mm2, PMA_mm2 = vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=CFG["HU_FAT"])
    VFA_cm2 = VFA_mm2 / 100.0
    ratio = (VFA_mm2 / PMA_mm2) if PMA_mm2 > 0 else None
    height_m = height_cm / 100.0
    PMI = (PMA_mm2 / 100.0) / (height_m**2) if height_m > 0 else None

    vfa_high = int(VFA_cm2 >= CFG["VFA_OBESITY_CUTOFF_CM2"])
    sarcopenia = int((PMI is not None) and (PMI < CFG["PMI_CUTOFF"][sex.upper()]))
    so_flag = int(bool(sarcopenia) and ((ratio is not None and ratio >= CFG["VFA_PSOAS_RATIO_CUTOFF"]) or vfa_high))

    # Overlay
    vfa_mask = cv2.bitwise_and(hu_mask(hu, *CFG["HU_FAT"]), inner)
    overlay = build_overlay(hu, inner, vb, vfa_mask, psoas_mask)

    res = Metrics(
        case_id=dcm_path.stem,
        sex=sex.upper(),
        height_m=height_m,
        PMA_mm2=float(round(PMA_mm2, 1)),
        VFA_mm2=float(round(VFA_mm2, 1)),
        ratio_VFA_PMA=(float(round(ratio, 2)) if ratio is not None else None),
        PMI_cm2_per_m2=(float(round(PMI, 2)) if PMI is not None else None),
        vfa_high=int(vfa_high),
        sarcopenia_pmi=int(sarcopenia),
        so_flag=int(so_flag),
    )
    return res, overlay
# -*- coding: utf-8 -*-
"""
L3 VFA / PMA / PMI – Core v3.7 (stabil, PMA fallback + VFA geri kazanım)
- DICOM zorunlu, PNG opsiyonel (aynı kesitse registration ile fasya kenarı güçlendirme)
- Fasya İÇİ VFA, anteromedial psoas seçimi (posterior dışlama), medial yakınlık, HU/şekil/eksen kısıtları
- PMA fallback: sıkı tarama başarısızsa gevşek tarama ile 0 kalmayı engeller
"""

from dataclasses import dataclass
from pathlib import Path
from typing import Optional, Tuple, Dict

import json
import math
import numpy as np
from pathlib import Path
DEBUG_DIR = Path.home() / 'Desktop' / 'L3_SO_ANALYSIS' / '_debug_out_FORCE'
DEBUG_DIR.mkdir(parents=True, exist_ok=True)
(Path(DEBUG_DIR/'import_marker.txt')).write_text('imported\n', encoding='utf-8')

__ULTRA_FORCE_ID__ = 'AO-3917'
print('[DEBUG] v3_7 LOADED', __ULTRA_FORCE_ID__, __file__)
print('[DEBUG] core file loaded:', __file__)
import cv2
import pydicom

# =========================
# Yapılandırma (override: settings.json)
# =========================
CFG = dict(
    # HU aralıkları
    HU_FAT=(-190, -30),
    HU_MUSCLE_BASE=(-29, 150),
    HU_MUSCLE_FALLBACK=(-60, 200),
    HU_BONE_SEED=(300, 3000),
    HU_BONE_CAND=(150, 2000),
    HU_BONE_EXCLUDE=(200, 4000),

    # Klinik eşikler
    PMI_CUTOFF={"M": 6.0, "F": 3.9},      # cm²/m²
    VFA_PSOAS_RATIO_CUTOFF=2.0,          # SO için yardımcı
    VFA_OBESITY_CUTOFF_CM2=100.0,        # cm²

    # Geometri / morfoloji
    RING_INNER_MM_BASE=6.0,
    RING_OUTER_MM_BASE=22.0,
    VERTEBRA_BUFFER_MM_BASE=3.0,
    MIN_PSOAS_AREA_MM2_BASE=150.0,
    MAX_PSOAS_AREA_MM2_BASE=2000.0,

    # Fasya kenar güçlendirme
    FASCIA_EDGE_Q=0.90,
    GRAD_STRENGTH_BASE=0.90,

    # Şekil / eksen kısıtları
    PSOAS_SHAPE_MIN_ECC=0.65,
    PSOAS_SHAPE_MIN_CONVEXITY=0.85,
    PSOAS_AXIS_MAX_DEG=25.0,

    # PNG registration
    PNG_REG_MAX_FEAT=2000,
    PNG_REG_GOOD_MATCH=80,
    PNG_REG_MIN_INLIERS=12,
)

# =========================
# Sonuç veri sınıfı
# =========================
@dataclass
class Metrics:
    case_id: str
    sex: str
    height_m: float
    PMA_mm2: float
    VFA_mm2: float
    ratio_VFA_PMA: Optional[float]
    PMI_cm2_per_m2: Optional[float]
    vfa_high: int
    sarcopenia_pmi: int
    so_flag: int  # (PMI<cutoff) and (VFA>=100cm2 or ratio>=2.0)

# =========================
# Ayar yükleme
# =========================
def load_settings(root_dir: Path):
    """settings.json varsa CFG’yi override eder."""
    sp = (root_dir / "settings.json")
    if sp.exists():
        try:
            data = json.loads(sp.read_text(encoding="utf-8"))
            for k, v in data.items():
                CFG[k] = v
            print(f"[INFO] settings.json yüklendi: {sp}")
        except Exception as e:
            print(f"[WARN] settings.json okunamadı: {e}")
        return res, overlay

# =========================
# DICOM / temel yardımcılar
# =========================
def load_hu(ds):
    arr = ds.pixel_array.astype(np.float32)
    slope = float(getattr(ds, "RescaleSlope", 1.0))
    inter = float(getattr(ds, "RescaleIntercept", 0.0))
    return arr * slope + inter

def pixel_spacing(ds) -> Tuple[float, float]:
    sp = getattr(ds, "PixelSpacing", None)
    if sp is None or len(sp) < 2:
        raise ValueError("PixelSpacing eksik.")
    return float(sp[0]), float(sp[1])

def px_area_mm2(ds) -> float:
    sy, sx = pixel_spacing(ds)
    return sy * sx

def mm_to_px(ds, mm: float) -> int:
    sy, sx = pixel_spacing(ds)
    s = (sy + sx) / 2.0
    return max(1, int(round(mm / max(1e-6, s))))

def area_px_from_mm2(ds, mm2: float) -> int:
    sy, sx = pixel_spacing(ds)
    return int(round(mm2 / (sy * sx + 1e-9)))

def hu_mask(hu, lo, hi):
    return ((hu >= lo) & (hu <= hi)).astype(np.uint8) * 255

def normalize8(hu, lo=-300, hi=300):
    img = np.clip(hu, lo, hi).astype(np.float32)
    return cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

def centroid(mask):
    m = (mask > 0).astype(np.uint8)
    if m.sum() == 0:
        return None
    M = cv2.moments(m)
    if M["m00"] == 0:
        return None
    return (M["m10"]/M["m00"], M["m01"]/M["m00"])

# =========================
# PNG ↔ DICOM registration (opsiyonel)
# =========================
def register_png_to_dicom(png_gray, dicom_gray):
    try:
        orb = cv2.ORB_create(nfeatures=CFG["PNG_REG_MAX_FEAT"], fastThreshold=5)
        k1, d1 = orb.detectAndCompute(png_gray, None)
        k2, d2 = orb.detectAndCompute(dicom_gray, None)
        if d1 is None or d2 is None or len(k1) < 20 or len(k2) < 20:
            return None
        bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=False)
        matches = bf.knnMatch(d1, d2, k=2)
        good = [m for m, n in matches if m.distance < 0.75 * n.distance]
        if len(good) < CFG["PNG_REG_GOOD_MATCH"]:
            return None
        src = np.float32([k1[m.queryIdx].pt for m in good]).reshape(-1, 1, 2)
        dst = np.float32([k2[m.trainIdx].pt for m in good]).reshape(-1, 1, 2)
        M, inliers = cv2.estimateAffine2D(src, dst, ransacReprojThreshold=3.0, confidence=0.99)
        if M is None or (inliers is not None and inliers.sum() < CFG["PNG_REG_MIN_INLIERS"]):
            return None
        return M
    except Exception:
        return None

def warp_png_with_affine(png_gray, shape_hw, M):
    h, w = shape_hw
    return cv2.warpAffine(png_gray, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)

# =========================
# Segmentasyon adımları
# =========================
def body_mask_from_hu(hu):
    img8 = normalize8(hu, -300, 300)
    img8 = cv2.GaussianBlur(img8, (7, 7), 0)
    _, th = cv2.threshold(img8, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    if np.mean(img8[th > 0]) < np.mean(img8[th == 0]):
        th = 255 - th
    th = cv2.morphologyEx(th, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 2)
    th = cv2.morphologyEx(th, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    return th

def vertebra_body_mask(hu):
    h, w = hu.shape
    cx, cy = w // 2, h // 2
    seed = hu_mask(hu, *CFG["HU_BONE_SEED"])
    cand = hu_mask(hu, *CFG["HU_BONE_CAND"])
    num, L, S, C = cv2.connectedComponentsWithStats(seed, 8)
    if num <= 1:
        return np.zeros_like(seed)
    minA, maxA = 0.001 * (h*w), 0.06 * (h*w)
    best, sc = 0, -1e9
    for lbl in range(1, num):
        x, y, ww, hh, a = S[lbl]
        if not (minA <= a <= maxA):
            continue
        mx, my = C[lbl]
        dist = math.hypot(mx - cx, my - cy)
        comp = (L == lbl).astype(np.uint8) * 255
        edges = cv2.Canny(comp, 0, 1)
        perim = float(np.count_nonzero(edges)) + 1e-6
        circ = 4.0 * np.pi * a / (perim * perim)
        s = a - 3.0 * dist + 5000.0 * circ
        if s > sc:
            best, sc = lbl, s
    if best == 0:
        return np.zeros_like(seed)
    seed_sel = (L == best).astype(np.uint8) * 255
    grown = cv2.bitwise_and(cand, cv2.dilate(seed_sel, np.ones((15, 15), np.uint8), 1))
    grown = cv2.morphologyEx(grown, cv2.MORPH_CLOSE, np.ones((11, 11), np.uint8), 2)
    grown = cv2.morphologyEx(grown, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    num2, L2, S2, _ = cv2.connectedComponentsWithStats(grown, 8)
    if num2 <= 1:
        return np.zeros_like(grown)
    best2, sc2 = 0, -1e9
    for lbl in range(1, num2):
        x, y, ww, hh, a = S2[lbl]
        mx, my = cv2.connectedComponentsWithStats(grown, 8)[3][lbl]
        dist = math.hypot(mx - cx, my - cy)
        s = a - 2.0 * dist
        if s > sc2:
            best2, sc2 = lbl, s
    vb = (L2 == best2).astype(np.uint8) * 255
    vb = cv2.morphologyEx(vb, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 1)
    return vb

def gradient_mask_u8(img8, ring, strength=0.85):
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    vals = mag[ring > 0]
    thr = np.percentile(vals, 100*strength) if vals.size >= 50 else np.percentile(mag, 90)
    g = (mag >= thr).astype(np.uint8) * 255
    return cv2.morphologyEx(g, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8), 1)

def refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=None):
    h, w = hu.shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    img8 = normalize8(hu, -200, 300)
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    thr = np.percentile(mag, CFG["FASCIA_EDGE_Q"]*100.0)
    wall_edges = (mag >= thr).astype(np.uint8)*255
    if png_edges is not None:
        wall_edges = cv2.bitwise_or(wall_edges, png_edges)
    wall_edges = cv2.bitwise_and(wall_edges, body_cc)

    gap = mm_to_px(ds, 6.0)
    wall_edges = cv2.morphologyEx(wall_edges, cv2.MORPH_CLOSE, np.ones((gap, gap), np.uint8), 1)

    wall_barrier = cv2.dilate(wall_edges, np.ones((3, 3), np.uint8), 1)
    barrier = cv2.bitwise_or(wall_barrier, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner2 = (tmp2 == 128).astype(np.uint8) * 255
    inner2 = cv2.bitwise_and(inner2, body_cc)
    inner2 = cv2.morphologyEx(inner2, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)
    return inner2, wall_edges

def inner_abdomen_via_wall(hu, ds, png_gray=None, png_band_mm=25, height_band_mm=80):
    body = body_mask_from_hu(hu)
    h, w = hu.shape
    vb = vertebra_body_mask(hu)
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    # body_cc (merkezle aynı komponent)
    num_b, Lb, _, _ = cv2.connectedComponentsWithStats((body > 0).astype(np.uint8), 8)
    body_cc = np.zeros_like(body)
    if num_b > 1:
        lbl = Lb[cy, cx]
        if lbl != 0:
            body_cc[Lb == lbl] = 255
    if body_cc.sum() == 0:
        body_cc = body

    # PNG kenarı (opsiyonel)
    png_edges = np.zeros_like(body_cc)
    if png_gray is not None:
        dicom8 = normalize8(hu, -200, 300)
        M = register_png_to_dicom(png_gray, dicom8)
        if M is not None:
            png_gray = warp_png_with_affine(png_gray, hu.shape, M)
        g = cv2.GaussianBlur(png_gray, (3, 3), 0)
        gx = cv2.Sobel(g, cv2.CV_32F, 1, 0, 3)
        gy = cv2.Sobel(g, cv2.CV_32F, 0, 1, 3)
        mag = cv2.magnitude(gx, gy)
        thr = np.percentile(mag, 88)
        full = (mag >= thr).astype(np.uint8) * 255
        band25 = mm_to_px(ds, png_band_mm)
        y1, y2 = max(0, cy - band25), min(h, cy + band25)
        png_edges[y1:y2, :] = full[y1:y2, :]
        png_edges = cv2.bitwise_and(png_edges, body_cc)

    # HU+gradient ile duvar
    img8 = normalize8(hu, -200, 300)
    sob = gradient_mask_u8(img8, body_cc, CFG["GRAD_STRENGTH_BASE"])
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    wall0 = cv2.bitwise_or(muscle, sob)
    wall0 = cv2.bitwise_or(wall0, png_edges)
    wall0 = cv2.bitwise_and(wall0, body_cc)

    # kaba inner
    wall = cv2.morphologyEx(wall0, cv2.MORPH_CLOSE,
                            np.ones((2*mm_to_px(ds, 5)+1, )*2, np.uint8), 1)
    wall = cv2.dilate(wall, np.ones((2*mm_to_px(ds, 2)+1, )*2, np.uint8), 1)
    barrier = cv2.bitwise_or(wall, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner = (tmp2 == 128).astype(np.uint8) * 255
    inner = cv2.bitwise_and(inner, body_cc)

    # aktif kontur rafinesi
    inner, wall_ref = refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=png_edges)

    # yükseklik bandı (L3 civarı)
    bandH = mm_to_px(ds, height_band_mm)
    y1, y2 = max(0, cy - bandH), min(h, cy + bandH)
    height_mask = np.zeros_like(inner); height_mask[y1:y2, :] = 255
    inner = cv2.bitwise_and(inner, height_mask)
    inner = cv2.morphologyEx(inner, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)

    # NOT: VFA düşmesin diye inner erozyonu UYGULAMIYORUZ (önceden kaldırıldı)
    return inner, wall_ref, vb, (cx, cy)

# =========================
# HU adaptasyonu / şekil skorları
# =========================
def adaptive_muscle_mask(hu, ring, base_range, fallback_range):
    vals = hu[ring > 0]
    vals = vals[(vals > fallback_range[0]) & (vals < fallback_range[1])]
    if vals.size >= 200:
        p10, p95 = np.percentile(vals, [10, 95])
        lo = max(fallback_range[0], min(base_range[0], p10 - 15))
        hi = min(fallback_range[1], max(base_range[1], p95 + 15))
        lo2 = max(fallback_range[0], min(lo, hi - 5))
        hi2 = min(fallback_range[1], max(hi, lo2 + 5))
        return hu_mask(hu, lo2, hi2), (float(lo2), float(hi2))
    return hu_mask(hu, *base_range), base_range

def shape_orientation_scores(comp_mask):
    m = (comp_mask > 0).astype(np.uint8)
    if cv2.countNonZero(m) == 0:
        return 0.0, 0.0, 0.0, 0.0
    cnts, _ = cv2.findContours(m, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return 0.0, 0.0, 0.0, 0.0
    cnt = max(cnts, key=cv2.contourArea)
    area = float(cv2.contourArea(cnt))
    hull = cv2.convexHull(cnt)
    hull_area = float(cv2.contourArea(hull)) + 1e-6
    convexity = max(0.0, min(1.0, area / hull_area))
    if len(cnt) >= 5:
        (_cx, _cy), (MA, ma), angle = cv2.fitEllipse(cnt)
        a = max(MA, ma) / 2.0
        b = max(1e-6, min(MA, ma) / 2.0)
        ecc = math.sqrt(max(0.0, 1.0 - (b*b)/(a*a)))
        axis_deg = float(angle)
    else:
        M = cv2.moments(cnt)
        if M["mu20"] + M["mu02"] == 0:
            ecc = 0.0; axis_deg = 0.0
        else:
            ang = 0.5 * math.atan2(2 * M["mu11"], (M["mu20"] - M["mu02"]))
            axis_deg = abs(np.degrees(ang))
            lam1 = (M["mu20"] + M["mu02"]) / 2 + math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            lam2 = (M["mu20"] + M["mu02"]) / 2 - math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            ecc = math.sqrt(max(0.0, 1.0 - (lam2+1e-6)/(lam1+1e-6)))
    # yataya yakınlık
    delta = min(abs(axis_deg - 0.0), abs(axis_deg - 180.0))
    axis_ok = 1.0 if delta <= CFG["PSOAS_AXIS_MAX_DEG"] else max(0.0, 1.0 - (delta - CFG["PSOAS_AXIS_MAX_DEG"])/CFG["PSOAS_AXIS_MAX_DEG"])
    ecc_ok = min(1.0, max(0.0, (ecc - CFG["PSOAS_SHAPE_MIN_ECC"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_ECC"] + 1e-6)))
    conv_ok = min(1.0, max(0.0, (convexity - CFG["PSOAS_SHAPE_MIN_CONVEXITY"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_CONVEXITY"] + 1e-6)))
    shape_score = 0.45*ecc_ok + 0.25*conv_ok + 0.30*axis_ok
    return float(ecc), float(convexity), float(axis_ok*100.0), float(shape_score)

# =========================
# (YENİ) PSOAS Yardımcıları + Bulucu
# =========================
def posterior_exclusion_mask(hu_shape, vb, ds, angle_right=(0,90), angle_left=(90,180)):
    """Posterior 180–360°’yi kapat, sağ/sol sektörleri üret."""
    h, w = hu_shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = cen
    yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
    dx, dy = xx - cx, cy - yy
    ang = (np.degrees(np.arctan2(dy, dx)) + 360.0) % 360.0
    R = ((ang >= angle_right[0]) & (ang <= angle_right[1])).astype(np.uint8)*255
    L = ((ang >= angle_left[0])  & (ang <= angle_left[1])).astype(np.uint8)*255
    POST = ((ang >= 180) & (ang < 360)).astype(np.uint8)*255
    return R, L, POST

def mediality_score(comp_mask, vb, ds, target_mm=10.0):
    inv_v = cv2.bitwise_not(vb)
    dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
    md = float(dist[comp_mask > 0].mean()) if cv2.countNonZero(comp_mask) else 1e9
    tgt_px = mm_to_px(ds, target_mm)
    if md <= 0 or tgt_px <= 0:
        return 0.0, md
    sc = max(0.0, min(1.0, (tgt_px / (md + 1e-6))))
    return sc, md

def refine_small_active_contour(mask):
    if mask is None or cv2.countNonZero(mask) == 0:
        return mask
    k = np.ones((3,3), np.uint8)
    out = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k, iterations=1)
    out = cv2.morphologyEx(out,  cv2.MORPH_OPEN,  k, iterations=1)
    return out

def find_psoas_inside(hu, ds, inner, vertebra,
                      ring_inner_mm=6.0, ring_outer_mm=22.0,
                      grad_strength=0.85,
                      min_area_mm2=150.0, max_area_mm2=2000.0):
    """
    Vertebranın anteromedialinde, fasya İÇİNDE psoas arar:
    - Sağ: 0–90°, Sol: 90–180°
    - Posterior 180–360° tamamen dışlanır
    - Vertebraya yakınlık (mediality), HU, şekil ve eksen kısıtları
    """
    h, w = hu.shape
    cen = centroid(vertebra)
    if cen is None:
        return np.zeros_like(vertebra), {"reason": "vertebra_not_found"}

    # Fasya içi halka
    i_px = mm_to_px(ds, ring_inner_mm)
    o_px = mm_to_px(ds, ring_outer_mm)
    dil_in  = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*i_px+1, 2*i_px+1)), 1)
    dil_out = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*o_px+1, 2*o_px+1)), 1)
    ring = cv2.bitwise_and(cv2.subtract(dil_out, dil_in), inner)

    # Sektörler
    Rsec, Lsec, POST = posterior_exclusion_mask(hu.shape, vertebra, ds)
    ring = cv2.bitwise_and(ring, cv2.bitwise_not(POST))

    # Aday kas maskesi
    img8 = normalize8(hu, -200, 300)
    gmask  = gradient_mask_u8(img8, ring, grad_strength)
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    base = cv2.bitwise_and(muscle, ring)
    base = cv2.bitwise_and(base, gmask)

    # Kemik + vertebra buffer dışı
    bone_ex = hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    base = cv2.bitwise_and(base, cv2.bitwise_not(bone_ex))
    base = cv2.bitwise_and(base, cv2.bitwise_not(vbuf))

    # Sağ/sol adaylar
    R_cand = cv2.bitwise_and(base, Rsec)
    L_cand = cv2.bitwise_and(base, Lsec)

    # Alan sınırları
    min_px = area_px_from_mm2(ds, min_area_mm2)
    max_px = area_px_from_mm2(ds, max_area_mm2)

    def pick_best(cand_mask):
        m = (cand_mask > 0).astype(np.uint8)
        num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
        best = {"mask": None, "area": 0, "md": 1e9, "shape": -1, "stats": None, "score": -1.0,
                "ecc":0.0, "conv":0.0, "axis_pct":0.0}
        if num <= 1:
            return best

        inv_v = cv2.bitwise_not(vertebra)
        dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)

        for lbl in range(1, num):
            comp = (L == lbl).astype(np.uint8)
            a = int(S[lbl, cv2.CC_STAT_AREA])
            if a < min_px or a > max_px:
                continue

            vals = hu[comp > 0]
            mean_hu, std_hu = float(vals.mean()), float(vals.std())
            if not (-10 <= mean_hu <= 80 and std_hu >= 8.0):
                continue

            # Medial yakınlık
            med_sc, md = mediality_score(comp, vertebra, ds, target_mm=10.0)
            if md < mm_to_px(ds, 3.0):  # vertebraya yapışık olmasın
                continue

            # Şekil/eksen
            ecc, conv, axis_pct, shape_sc = shape_orientation_scores(comp)
            axis_ok = axis_pct/100.0
            if axis_ok <= 0.2:
                continue

            # HU stabilitesi (yumuşak kriter)
            hu_stab = min(1.0, std_hu/15.0) * 0.5 + (1.0 - abs(mean_hu-40)/80.0)*0.5
            hu_stab = max(0.0, min(1.0, hu_stab))

            score = 0.45*med_sc + 0.35*shape_sc + 0.20*hu_stab
            if score > best["score"]:
                best.update({
                    "mask": comp*255, "area": a, "md": md, "shape": shape_sc,
                    "stats": (mean_hu, std_hu), "score": score,
                    "ecc": ecc, "conv": conv, "axis_pct": axis_pct
                })

        if best["mask"] is not None:
            best["mask"] = refine_small_active_contour(best["mask"])
        return best

    Rbest = pick_best(R_cand)
    Lbest = pick_best(L_cand)

    # --- Fallback: Eğer her iki taraf da bulunamadıysa, kriterleri gevşeterek tekrar dene
    if Rbest["mask"] is None and Lbest["mask"] is None:
        HU_SOFT = (-20, 100)
        base_soft = cv2.bitwise_and(hu_mask(hu, *HU_SOFT), ring)
        base_soft = cv2.bitwise_and(base_soft, cv2.bitwise_not(hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])))
        vbuf2 = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                        (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
        base_soft = cv2.bitwise_and(base_soft, cv2.bitwise_not(vbuf2))

        R_cand2 = cv2.bitwise_and(base_soft, Rsec)
        L_cand2 = cv2.bitwise_and(base_soft, Lsec)

        def pick_loose(cand_mask):
            m = (cand_mask > 0).astype(np.uint8)
            num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
            best = {"mask": None, "area": 0, "md": 1e9, "score": -1.0}
            if num <= 1:
                return best
            inv_v = cv2.bitwise_not(vertebra)
            dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
            min_px2 = area_px_from_mm2(ds, 80.0)
            max_px2 = area_px_from_mm2(ds, 3500.0)
            for lbl in range(1, num):
                comp = (L == lbl).astype(np.uint8)
                a = int(S[lbl, cv2.CC_STAT_AREA])
                if a < min_px2 or a > max_px2:
                    continue
                vals = hu[comp > 0]
                mean_hu, std_hu = float(vals.mean()), float(vals.std())
                if not (-20 <= mean_hu <= 100 and std_hu >= 5.0):
                    continue
                med_sc, md = mediality_score(comp, vertebra, ds, target_mm=12.0)
                if md < mm_to_px(ds, 2.0):
                    continue
                score = med_sc + std_hu/20.0
                if score > best["score"]:
                    best.update({"mask": comp*255, "area": a, "md": md, "score": score})
            if best["mask"] is not None:
                best["mask"] = refine_small_active_contour(best["mask"])
            return best

        Rbest2 = pick_loose(R_cand2)
        Lbest2 = pick_loose(L_cand2)
        if Rbest2["mask"] is not None: Rbest = Rbest2
        if Lbest2["mask"] is not None: Lbest = Lbest2

    psoas = np.zeros_like(vertebra)
    if Rbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Rbest["mask"])
    if Lbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Lbest["mask"])

    # Fasya içi ve vertebra buffer dışı garantisi
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    psoas = cv2.bitwise_and(psoas, inner)
    psoas = cv2.bitwise_and(psoas, cv2.bitwise_not(vbuf))

    dbg = {
        "R_area_px": int(Rbest.get("area", 0) or 0),
        "L_area_px": int(Lbest.get("area", 0) or 0),
        "R_mean_dist": float(Rbest.get("md", 0.0) or 0.0),
        "L_mean_dist": float(Lbest.get("md", 0.0) or 0.0),
        "R_stats": Rbest.get("stats"),
        "L_stats": Lbest.get("stats"),
        "Rshape": float(Rbest.get("shape", -1.0) or -1.0),
        "Lshape": float(Lbest.get("shape", -1.0) or -1.0),
        "R_score": float(Rbest.get("score", -1.0) or -1.0),
        "L_score": float(Lbest.get("score", -1.0) or -1.0)
    }
    return psoas, dbg

# =========================
# Ölçüm / Overlay
# =========================
def vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=None):
    pxA = px_area_mm2(ds)
    lo, hi = (fat_range if fat_range else CFG["HU_FAT"])
    fat_mask = hu_mask(hu, lo, hi)
    vfa_px = int(np.count_nonzero(cv2.bitwise_and(fat_mask, inner)))
    pma_px = int(np.count_nonzero(psoas_mask))
    VFA_mm2 = vfa_px * pxA
    PMA_mm2 = pma_px * pxA
    return VFA_mm2, PMA_mm2

def build_overlay(hu, inner, vertebra, vfa_mask, psoas_mask):
    base = normalize8(hu, -200, 300)
    base = cv2.cvtColor(base, cv2.COLOR_GRAY2BGR)
    base[inner == 0] = (base[inner == 0] * 0.25).astype(np.uint8)
    # VFA: yeşil, Psoas: sarı, Vertebra: kırmızı
    for (m, col, al) in ((vfa_mask, (0,255,0), 0.35), (psoas_mask, (0,255,255), 0.55), (vertebra, (255,0,0), 0.35)):
        if m is None: continue
        m_in = cv2.bitwise_and(m, inner)
        a = ((m_in > 0).astype(np.float32)) * al
        colimg = np.full_like(base, col, np.uint8)
        base = (base * (1 - a[..., None]) + colimg * a[..., None]).astype(np.uint8)
    # kontur çiz
    for m, c in ((vfa_mask, (0,255,0)), (psoas_mask, (0,255,255))):
        m_in = cv2.bitwise_and(m, inner)
        cnts, _ = cv2.findContours((m_in > 0).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cv2.drawContours(base, cnts, -1, c, 2, lineType=cv2.LINE_AA)
    return base

# =========================
# Ana dış API
# =========================
def run_case(dcm_path: Path, height_cm: float, sex: str, png_path: Optional[Path] = None) -> Tuple[Metrics, Optional[np.ndarray]]:
    """
    GUI’nin çağırdığı tek giriş noktası.
    DICOM zorunlu, PNG opsiyonel (aynı kesitse registration faydalı).
    """
    dcm_path = Path(dcm_path)
    ds = pydicom.dcmread(str(dcm_path))
    hu = load_hu(ds)

    png_gray = None
    if png_path and Path(png_path).exists():
        png_gray = cv2.imread(str(png_path), cv2.IMREAD_GRAYSCALE)

    # Fasya içi alan + vertebra
    inner, wall_ref, vb, _ = inner_abdomen_via_wall(hu, ds, png_gray=png_gray, png_band_mm=25, height_band_mm=80)

    # Psoas (anteromedial, posterior dışlama)
    psoas_mask, _dbg = find_psoas_inside(
        hu, ds, inner, vb,
        ring_inner_mm=CFG["RING_INNER_MM_BASE"],
        ring_outer_mm=CFG["RING_OUTER_MM_BASE"],
        grad_strength=CFG["GRAD_STRENGTH_BASE"],
        min_area_mm2=CFG["MIN_PSOAS_AREA_MM2_BASE"],
        max_area_mm2=CFG["MAX_PSOAS_AREA_MM2_BASE"]
    )

    # VFA/PMA
    VFA_mm2, PMA_mm2 = vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=CFG["HU_FAT"])
    VFA_cm2 = VFA_mm2 / 100.0
    ratio = (VFA_mm2 / PMA_mm2) if PMA_mm2 > 0 else None
    height_m = height_cm / 100.0
    PMI = (PMA_mm2 / 100.0) / (height_m**2) if height_m > 0 else None

    vfa_high = int(VFA_cm2 >= CFG["VFA_OBESITY_CUTOFF_CM2"])
    sarcopenia = int((PMI is not None) and (PMI < CFG["PMI_CUTOFF"][sex.upper()]))
    so_flag = int(bool(sarcopenia) and ((ratio is not None and ratio >= CFG["VFA_PSOAS_RATIO_CUTOFF"]) or vfa_high))

    # Overlay
    vfa_mask = cv2.bitwise_and(hu_mask(hu, *CFG["HU_FAT"]), inner)
    overlay = build_overlay(hu, inner, vb, vfa_mask, psoas_mask)

    res = Metrics(
        case_id=dcm_path.stem,
        sex=sex.upper(),
        height_m=height_m,
        PMA_mm2=float(round(PMA_mm2, 1)),
        VFA_mm2=float(round(VFA_mm2, 1)),
        ratio_VFA_PMA=(float(round(ratio, 2)) if ratio is not None else None),
        PMI_cm2_per_m2=(float(round(PMI, 2)) if PMI is not None else None),
        vfa_high=int(vfa_high),
        sarcopenia_pmi=int(sarcopenia),
        so_flag=int(so_flag),
    )
    return res, overlay
# -*- coding: utf-8 -*-
"""
L3 VFA / PMA / PMI – Core v3.7 (stabil, PMA fallback + VFA geri kazanım)
- DICOM zorunlu, PNG opsiyonel (aynı kesitse registration ile fasya kenarı güçlendirme)
- Fasya İÇİ VFA, anteromedial psoas seçimi (posterior dışlama), medial yakınlık, HU/şekil/eksen kısıtları
- PMA fallback: sıkı tarama başarısızsa gevşek tarama ile 0 kalmayı engeller
"""

from dataclasses import dataclass
from pathlib import Path
from typing import Optional, Tuple, Dict

import json
import math
import numpy as np
from pathlib import Path
DEBUG_DIR = Path.home() / 'Desktop' / 'L3_SO_ANALYSIS' / '_debug_out_FORCE'
DEBUG_DIR.mkdir(parents=True, exist_ok=True)
(Path(DEBUG_DIR/'import_marker.txt')).write_text('imported\n', encoding='utf-8')

__ULTRA_FORCE_ID__ = 'AO-3917'
print('[DEBUG] v3_7 LOADED', __ULTRA_FORCE_ID__, __file__)
print('[DEBUG] core file loaded:', __file__)
import cv2
import pydicom

# =========================
# Yapılandırma (override: settings.json)
# =========================
CFG = dict(
    # HU aralıkları
    HU_FAT=(-190, -30),
    HU_MUSCLE_BASE=(-29, 150),
    HU_MUSCLE_FALLBACK=(-60, 200),
    HU_BONE_SEED=(300, 3000),
    HU_BONE_CAND=(150, 2000),
    HU_BONE_EXCLUDE=(200, 4000),

    # Klinik eşikler
    PMI_CUTOFF={"M": 6.0, "F": 3.9},      # cm²/m²
    VFA_PSOAS_RATIO_CUTOFF=2.0,          # SO için yardımcı
    VFA_OBESITY_CUTOFF_CM2=100.0,        # cm²

    # Geometri / morfoloji
    RING_INNER_MM_BASE=6.0,
    RING_OUTER_MM_BASE=22.0,
    VERTEBRA_BUFFER_MM_BASE=3.0,
    MIN_PSOAS_AREA_MM2_BASE=150.0,
    MAX_PSOAS_AREA_MM2_BASE=2000.0,

    # Fasya kenar güçlendirme
    FASCIA_EDGE_Q=0.90,
    GRAD_STRENGTH_BASE=0.90,

    # Şekil / eksen kısıtları
    PSOAS_SHAPE_MIN_ECC=0.65,
    PSOAS_SHAPE_MIN_CONVEXITY=0.85,
    PSOAS_AXIS_MAX_DEG=25.0,

    # PNG registration
    PNG_REG_MAX_FEAT=2000,
    PNG_REG_GOOD_MATCH=80,
    PNG_REG_MIN_INLIERS=12,
)

# =========================
# Sonuç veri sınıfı
# =========================
@dataclass
class Metrics:
    case_id: str
    sex: str
    height_m: float
    PMA_mm2: float
    VFA_mm2: float
    ratio_VFA_PMA: Optional[float]
    PMI_cm2_per_m2: Optional[float]
    vfa_high: int
    sarcopenia_pmi: int
    so_flag: int  # (PMI<cutoff) and (VFA>=100cm2 or ratio>=2.0)

# =========================
# Ayar yükleme
# =========================
def load_settings(root_dir: Path):
    """settings.json varsa CFG’yi override eder."""
    sp = (root_dir / "settings.json")
    if sp.exists():
        try:
            data = json.loads(sp.read_text(encoding="utf-8"))
            for k, v in data.items():
                CFG[k] = v
            print(f"[INFO] settings.json yüklendi: {sp}")
        except Exception as e:
            print(f"[WARN] settings.json okunamadı: {e}")
        return res, overlay

# =========================
# DICOM / temel yardımcılar
# =========================
def load_hu(ds):
    arr = ds.pixel_array.astype(np.float32)
    slope = float(getattr(ds, "RescaleSlope", 1.0))
    inter = float(getattr(ds, "RescaleIntercept", 0.0))
    return arr * slope + inter

def pixel_spacing(ds) -> Tuple[float, float]:
    sp = getattr(ds, "PixelSpacing", None)
    if sp is None or len(sp) < 2:
        raise ValueError("PixelSpacing eksik.")
    return float(sp[0]), float(sp[1])

def px_area_mm2(ds) -> float:
    sy, sx = pixel_spacing(ds)
    return sy * sx

def mm_to_px(ds, mm: float) -> int:
    sy, sx = pixel_spacing(ds)
    s = (sy + sx) / 2.0
    return max(1, int(round(mm / max(1e-6, s))))

def area_px_from_mm2(ds, mm2: float) -> int:
    sy, sx = pixel_spacing(ds)
    return int(round(mm2 / (sy * sx + 1e-9)))

def hu_mask(hu, lo, hi):
    return ((hu >= lo) & (hu <= hi)).astype(np.uint8) * 255

def normalize8(hu, lo=-300, hi=300):
    img = np.clip(hu, lo, hi).astype(np.float32)
    return cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

def centroid(mask):
    m = (mask > 0).astype(np.uint8)
    if m.sum() == 0:
        return None
    M = cv2.moments(m)
    if M["m00"] == 0:
        return None
    return (M["m10"]/M["m00"], M["m01"]/M["m00"])

# =========================
# PNG ↔ DICOM registration (opsiyonel)
# =========================
def register_png_to_dicom(png_gray, dicom_gray):
    try:
        orb = cv2.ORB_create(nfeatures=CFG["PNG_REG_MAX_FEAT"], fastThreshold=5)
        k1, d1 = orb.detectAndCompute(png_gray, None)
        k2, d2 = orb.detectAndCompute(dicom_gray, None)
        if d1 is None or d2 is None or len(k1) < 20 or len(k2) < 20:
            return None
        bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=False)
        matches = bf.knnMatch(d1, d2, k=2)
        good = [m for m, n in matches if m.distance < 0.75 * n.distance]
        if len(good) < CFG["PNG_REG_GOOD_MATCH"]:
            return None
        src = np.float32([k1[m.queryIdx].pt for m in good]).reshape(-1, 1, 2)
        dst = np.float32([k2[m.trainIdx].pt for m in good]).reshape(-1, 1, 2)
        M, inliers = cv2.estimateAffine2D(src, dst, ransacReprojThreshold=3.0, confidence=0.99)
        if M is None or (inliers is not None and inliers.sum() < CFG["PNG_REG_MIN_INLIERS"]):
            return None
        return M
    except Exception:
        return None

def warp_png_with_affine(png_gray, shape_hw, M):
    h, w = shape_hw
    return cv2.warpAffine(png_gray, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)

# =========================
# Segmentasyon adımları
# =========================
def body_mask_from_hu(hu):
    img8 = normalize8(hu, -300, 300)
    img8 = cv2.GaussianBlur(img8, (7, 7), 0)
    _, th = cv2.threshold(img8, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    if np.mean(img8[th > 0]) < np.mean(img8[th == 0]):
        th = 255 - th
    th = cv2.morphologyEx(th, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 2)
    th = cv2.morphologyEx(th, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    return th

def vertebra_body_mask(hu):
    h, w = hu.shape
    cx, cy = w // 2, h // 2
    seed = hu_mask(hu, *CFG["HU_BONE_SEED"])
    cand = hu_mask(hu, *CFG["HU_BONE_CAND"])
    num, L, S, C = cv2.connectedComponentsWithStats(seed, 8)
    if num <= 1:
        return np.zeros_like(seed)
    minA, maxA = 0.001 * (h*w), 0.06 * (h*w)
    best, sc = 0, -1e9
    for lbl in range(1, num):
        x, y, ww, hh, a = S[lbl]
        if not (minA <= a <= maxA):
            continue
        mx, my = C[lbl]
        dist = math.hypot(mx - cx, my - cy)
        comp = (L == lbl).astype(np.uint8) * 255
        edges = cv2.Canny(comp, 0, 1)
        perim = float(np.count_nonzero(edges)) + 1e-6
        circ = 4.0 * np.pi * a / (perim * perim)
        s = a - 3.0 * dist + 5000.0 * circ
        if s > sc:
            best, sc = lbl, s
    if best == 0:
        return np.zeros_like(seed)
    seed_sel = (L == best).astype(np.uint8) * 255
    grown = cv2.bitwise_and(cand, cv2.dilate(seed_sel, np.ones((15, 15), np.uint8), 1))
    grown = cv2.morphologyEx(grown, cv2.MORPH_CLOSE, np.ones((11, 11), np.uint8), 2)
    grown = cv2.morphologyEx(grown, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    num2, L2, S2, _ = cv2.connectedComponentsWithStats(grown, 8)
    if num2 <= 1:
        return np.zeros_like(grown)
    best2, sc2 = 0, -1e9
    for lbl in range(1, num2):
        x, y, ww, hh, a = S2[lbl]
        mx, my = cv2.connectedComponentsWithStats(grown, 8)[3][lbl]
        dist = math.hypot(mx - cx, my - cy)
        s = a - 2.0 * dist
        if s > sc2:
            best2, sc2 = lbl, s
    vb = (L2 == best2).astype(np.uint8) * 255
    vb = cv2.morphologyEx(vb, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 1)
    return vb

def gradient_mask_u8(img8, ring, strength=0.85):
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    vals = mag[ring > 0]
    thr = np.percentile(vals, 100*strength) if vals.size >= 50 else np.percentile(mag, 90)
    g = (mag >= thr).astype(np.uint8) * 255
    return cv2.morphologyEx(g, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8), 1)

def refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=None):
    h, w = hu.shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    img8 = normalize8(hu, -200, 300)
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    thr = np.percentile(mag, CFG["FASCIA_EDGE_Q"]*100.0)
    wall_edges = (mag >= thr).astype(np.uint8)*255
    if png_edges is not None:
        wall_edges = cv2.bitwise_or(wall_edges, png_edges)
    wall_edges = cv2.bitwise_and(wall_edges, body_cc)

    gap = mm_to_px(ds, 6.0)
    wall_edges = cv2.morphologyEx(wall_edges, cv2.MORPH_CLOSE, np.ones((gap, gap), np.uint8), 1)

    wall_barrier = cv2.dilate(wall_edges, np.ones((3, 3), np.uint8), 1)
    barrier = cv2.bitwise_or(wall_barrier, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner2 = (tmp2 == 128).astype(np.uint8) * 255
    inner2 = cv2.bitwise_and(inner2, body_cc)
    inner2 = cv2.morphologyEx(inner2, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)
    return inner2, wall_edges

def inner_abdomen_via_wall(hu, ds, png_gray=None, png_band_mm=25, height_band_mm=80):
    body = body_mask_from_hu(hu)
    h, w = hu.shape
    vb = vertebra_body_mask(hu)
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    # body_cc (merkezle aynı komponent)
    num_b, Lb, _, _ = cv2.connectedComponentsWithStats((body > 0).astype(np.uint8), 8)
    body_cc = np.zeros_like(body)
    if num_b > 1:
        lbl = Lb[cy, cx]
        if lbl != 0:
            body_cc[Lb == lbl] = 255
    if body_cc.sum() == 0:
        body_cc = body

    # PNG kenarı (opsiyonel)
    png_edges = np.zeros_like(body_cc)
    if png_gray is not None:
        dicom8 = normalize8(hu, -200, 300)
        M = register_png_to_dicom(png_gray, dicom8)
        if M is not None:
            png_gray = warp_png_with_affine(png_gray, hu.shape, M)
        g = cv2.GaussianBlur(png_gray, (3, 3), 0)
        gx = cv2.Sobel(g, cv2.CV_32F, 1, 0, 3)
        gy = cv2.Sobel(g, cv2.CV_32F, 0, 1, 3)
        mag = cv2.magnitude(gx, gy)
        thr = np.percentile(mag, 88)
        full = (mag >= thr).astype(np.uint8) * 255
        band25 = mm_to_px(ds, png_band_mm)
        y1, y2 = max(0, cy - band25), min(h, cy + band25)
        png_edges[y1:y2, :] = full[y1:y2, :]
        png_edges = cv2.bitwise_and(png_edges, body_cc)

    # HU+gradient ile duvar
    img8 = normalize8(hu, -200, 300)
    sob = gradient_mask_u8(img8, body_cc, CFG["GRAD_STRENGTH_BASE"])
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    wall0 = cv2.bitwise_or(muscle, sob)
    wall0 = cv2.bitwise_or(wall0, png_edges)
    wall0 = cv2.bitwise_and(wall0, body_cc)

    # kaba inner
    wall = cv2.morphologyEx(wall0, cv2.MORPH_CLOSE,
                            np.ones((2*mm_to_px(ds, 5)+1, )*2, np.uint8), 1)
    wall = cv2.dilate(wall, np.ones((2*mm_to_px(ds, 2)+1, )*2, np.uint8), 1)
    barrier = cv2.bitwise_or(wall, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner = (tmp2 == 128).astype(np.uint8) * 255
    inner = cv2.bitwise_and(inner, body_cc)

    # aktif kontur rafinesi
    inner, wall_ref = refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=png_edges)

    # yükseklik bandı (L3 civarı)
    bandH = mm_to_px(ds, height_band_mm)
    y1, y2 = max(0, cy - bandH), min(h, cy + bandH)
    height_mask = np.zeros_like(inner); height_mask[y1:y2, :] = 255
    inner = cv2.bitwise_and(inner, height_mask)
    inner = cv2.morphologyEx(inner, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)

    # NOT: VFA düşmesin diye inner erozyonu UYGULAMIYORUZ (önceden kaldırıldı)
    return inner, wall_ref, vb, (cx, cy)

# =========================
# HU adaptasyonu / şekil skorları
# =========================
def adaptive_muscle_mask(hu, ring, base_range, fallback_range):
    vals = hu[ring > 0]
    vals = vals[(vals > fallback_range[0]) & (vals < fallback_range[1])]
    if vals.size >= 200:
        p10, p95 = np.percentile(vals, [10, 95])
        lo = max(fallback_range[0], min(base_range[0], p10 - 15))
        hi = min(fallback_range[1], max(base_range[1], p95 + 15))
        lo2 = max(fallback_range[0], min(lo, hi - 5))
        hi2 = min(fallback_range[1], max(hi, lo2 + 5))
        return hu_mask(hu, lo2, hi2), (float(lo2), float(hi2))
    return hu_mask(hu, *base_range), base_range

def shape_orientation_scores(comp_mask):
    m = (comp_mask > 0).astype(np.uint8)
    if cv2.countNonZero(m) == 0:
        return 0.0, 0.0, 0.0, 0.0
    cnts, _ = cv2.findContours(m, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return 0.0, 0.0, 0.0, 0.0
    cnt = max(cnts, key=cv2.contourArea)
    area = float(cv2.contourArea(cnt))
    hull = cv2.convexHull(cnt)
    hull_area = float(cv2.contourArea(hull)) + 1e-6
    convexity = max(0.0, min(1.0, area / hull_area))
    if len(cnt) >= 5:
        (_cx, _cy), (MA, ma), angle = cv2.fitEllipse(cnt)
        a = max(MA, ma) / 2.0
        b = max(1e-6, min(MA, ma) / 2.0)
        ecc = math.sqrt(max(0.0, 1.0 - (b*b)/(a*a)))
        axis_deg = float(angle)
    else:
        M = cv2.moments(cnt)
        if M["mu20"] + M["mu02"] == 0:
            ecc = 0.0; axis_deg = 0.0
        else:
            ang = 0.5 * math.atan2(2 * M["mu11"], (M["mu20"] - M["mu02"]))
            axis_deg = abs(np.degrees(ang))
            lam1 = (M["mu20"] + M["mu02"]) / 2 + math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            lam2 = (M["mu20"] + M["mu02"]) / 2 - math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            ecc = math.sqrt(max(0.0, 1.0 - (lam2+1e-6)/(lam1+1e-6)))
    # yataya yakınlık
    delta = min(abs(axis_deg - 0.0), abs(axis_deg - 180.0))
    axis_ok = 1.0 if delta <= CFG["PSOAS_AXIS_MAX_DEG"] else max(0.0, 1.0 - (delta - CFG["PSOAS_AXIS_MAX_DEG"])/CFG["PSOAS_AXIS_MAX_DEG"])
    ecc_ok = min(1.0, max(0.0, (ecc - CFG["PSOAS_SHAPE_MIN_ECC"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_ECC"] + 1e-6)))
    conv_ok = min(1.0, max(0.0, (convexity - CFG["PSOAS_SHAPE_MIN_CONVEXITY"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_CONVEXITY"] + 1e-6)))
    shape_score = 0.45*ecc_ok + 0.25*conv_ok + 0.30*axis_ok
    return float(ecc), float(convexity), float(axis_ok*100.0), float(shape_score)

# =========================
# (YENİ) PSOAS Yardımcıları + Bulucu
# =========================
def posterior_exclusion_mask(hu_shape, vb, ds, angle_right=(0,90), angle_left=(90,180)):
    """Posterior 180–360°’yi kapat, sağ/sol sektörleri üret."""
    h, w = hu_shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = cen
    yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
    dx, dy = xx - cx, cy - yy
    ang = (np.degrees(np.arctan2(dy, dx)) + 360.0) % 360.0
    R = ((ang >= angle_right[0]) & (ang <= angle_right[1])).astype(np.uint8)*255
    L = ((ang >= angle_left[0])  & (ang <= angle_left[1])).astype(np.uint8)*255
    POST = ((ang >= 180) & (ang < 360)).astype(np.uint8)*255
    return R, L, POST

def mediality_score(comp_mask, vb, ds, target_mm=10.0):
    inv_v = cv2.bitwise_not(vb)
    dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
    md = float(dist[comp_mask > 0].mean()) if cv2.countNonZero(comp_mask) else 1e9
    tgt_px = mm_to_px(ds, target_mm)
    if md <= 0 or tgt_px <= 0:
        return 0.0, md
    sc = max(0.0, min(1.0, (tgt_px / (md + 1e-6))))
    return sc, md

def refine_small_active_contour(mask):
    if mask is None or cv2.countNonZero(mask) == 0:
        return mask
    k = np.ones((3,3), np.uint8)
    out = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k, iterations=1)
    out = cv2.morphologyEx(out,  cv2.MORPH_OPEN,  k, iterations=1)
    return out

def find_psoas_inside(hu, ds, inner, vertebra,
                      ring_inner_mm=6.0, ring_outer_mm=22.0,
                      grad_strength=0.85,
                      min_area_mm2=150.0, max_area_mm2=2000.0):
    """
    Vertebranın anteromedialinde, fasya İÇİNDE psoas arar:
    - Sağ: 0–90°, Sol: 90–180°
    - Posterior 180–360° tamamen dışlanır
    - Vertebraya yakınlık (mediality), HU, şekil ve eksen kısıtları
    """
    h, w = hu.shape
    cen = centroid(vertebra)
    if cen is None:
        return np.zeros_like(vertebra), {"reason": "vertebra_not_found"}

    # Fasya içi halka
    i_px = mm_to_px(ds, ring_inner_mm)
    o_px = mm_to_px(ds, ring_outer_mm)
    dil_in  = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*i_px+1, 2*i_px+1)), 1)
    dil_out = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*o_px+1, 2*o_px+1)), 1)
    ring = cv2.bitwise_and(cv2.subtract(dil_out, dil_in), inner)

    # Sektörler
    Rsec, Lsec, POST = posterior_exclusion_mask(hu.shape, vertebra, ds)
    ring = cv2.bitwise_and(ring, cv2.bitwise_not(POST))

    # Aday kas maskesi
    img8 = normalize8(hu, -200, 300)
    gmask  = gradient_mask_u8(img8, ring, grad_strength)
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    base = cv2.bitwise_and(muscle, ring)
    base = cv2.bitwise_and(base, gmask)

    # Kemik + vertebra buffer dışı
    bone_ex = hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    base = cv2.bitwise_and(base, cv2.bitwise_not(bone_ex))
    base = cv2.bitwise_and(base, cv2.bitwise_not(vbuf))

    # Sağ/sol adaylar
    R_cand = cv2.bitwise_and(base, Rsec)
    L_cand = cv2.bitwise_and(base, Lsec)

    # Alan sınırları
    min_px = area_px_from_mm2(ds, min_area_mm2)
    max_px = area_px_from_mm2(ds, max_area_mm2)

    def pick_best(cand_mask):
        m = (cand_mask > 0).astype(np.uint8)
        num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
        best = {"mask": None, "area": 0, "md": 1e9, "shape": -1, "stats": None, "score": -1.0,
                "ecc":0.0, "conv":0.0, "axis_pct":0.0}
        if num <= 1:
            return best

        inv_v = cv2.bitwise_not(vertebra)
        dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)

        for lbl in range(1, num):
            comp = (L == lbl).astype(np.uint8)
            a = int(S[lbl, cv2.CC_STAT_AREA])
            if a < min_px or a > max_px:
                continue

            vals = hu[comp > 0]
            mean_hu, std_hu = float(vals.mean()), float(vals.std())
            if not (-10 <= mean_hu <= 80 and std_hu >= 8.0):
                continue

            # Medial yakınlık
            med_sc, md = mediality_score(comp, vertebra, ds, target_mm=10.0)
            if md < mm_to_px(ds, 3.0):  # vertebraya yapışık olmasın
                continue

            # Şekil/eksen
            ecc, conv, axis_pct, shape_sc = shape_orientation_scores(comp)
            axis_ok = axis_pct/100.0
            if axis_ok <= 0.2:
                continue

            # HU stabilitesi (yumuşak kriter)
            hu_stab = min(1.0, std_hu/15.0) * 0.5 + (1.0 - abs(mean_hu-40)/80.0)*0.5
            hu_stab = max(0.0, min(1.0, hu_stab))

            score = 0.45*med_sc + 0.35*shape_sc + 0.20*hu_stab
            if score > best["score"]:
                best.update({
                    "mask": comp*255, "area": a, "md": md, "shape": shape_sc,
                    "stats": (mean_hu, std_hu), "score": score,
                    "ecc": ecc, "conv": conv, "axis_pct": axis_pct
                })

        if best["mask"] is not None:
            best["mask"] = refine_small_active_contour(best["mask"])
        return best

    Rbest = pick_best(R_cand)
    Lbest = pick_best(L_cand)

    # --- Fallback: Eğer her iki taraf da bulunamadıysa, kriterleri gevşeterek tekrar dene
    if Rbest["mask"] is None and Lbest["mask"] is None:
        HU_SOFT = (-20, 100)
        base_soft = cv2.bitwise_and(hu_mask(hu, *HU_SOFT), ring)
        base_soft = cv2.bitwise_and(base_soft, cv2.bitwise_not(hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])))
        vbuf2 = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                        (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
        base_soft = cv2.bitwise_and(base_soft, cv2.bitwise_not(vbuf2))

        R_cand2 = cv2.bitwise_and(base_soft, Rsec)
        L_cand2 = cv2.bitwise_and(base_soft, Lsec)

        def pick_loose(cand_mask):
            m = (cand_mask > 0).astype(np.uint8)
            num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
            best = {"mask": None, "area": 0, "md": 1e9, "score": -1.0}
            if num <= 1:
                return best
            inv_v = cv2.bitwise_not(vertebra)
            dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
            min_px2 = area_px_from_mm2(ds, 80.0)
            max_px2 = area_px_from_mm2(ds, 3500.0)
            for lbl in range(1, num):
                comp = (L == lbl).astype(np.uint8)
                a = int(S[lbl, cv2.CC_STAT_AREA])
                if a < min_px2 or a > max_px2:
                    continue
                vals = hu[comp > 0]
                mean_hu, std_hu = float(vals.mean()), float(vals.std())
                if not (-20 <= mean_hu <= 100 and std_hu >= 5.0):
                    continue
                med_sc, md = mediality_score(comp, vertebra, ds, target_mm=12.0)
                if md < mm_to_px(ds, 2.0):
                    continue
                score = med_sc + std_hu/20.0
                if score > best["score"]:
                    best.update({"mask": comp*255, "area": a, "md": md, "score": score})
            if best["mask"] is not None:
                best["mask"] = refine_small_active_contour(best["mask"])
            return best

        Rbest2 = pick_loose(R_cand2)
        Lbest2 = pick_loose(L_cand2)
        if Rbest2["mask"] is not None: Rbest = Rbest2
        if Lbest2["mask"] is not None: Lbest = Lbest2

    psoas = np.zeros_like(vertebra)
    if Rbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Rbest["mask"])
    if Lbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Lbest["mask"])

    # Fasya içi ve vertebra buffer dışı garantisi
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    psoas = cv2.bitwise_and(psoas, inner)
    psoas = cv2.bitwise_and(psoas, cv2.bitwise_not(vbuf))

    dbg = {
        "R_area_px": int(Rbest.get("area", 0) or 0),
        "L_area_px": int(Lbest.get("area", 0) or 0),
        "R_mean_dist": float(Rbest.get("md", 0.0) or 0.0),
        "L_mean_dist": float(Lbest.get("md", 0.0) or 0.0),
        "R_stats": Rbest.get("stats"),
        "L_stats": Lbest.get("stats"),
        "Rshape": float(Rbest.get("shape", -1.0) or -1.0),
        "Lshape": float(Lbest.get("shape", -1.0) or -1.0),
        "R_score": float(Rbest.get("score", -1.0) or -1.0),
        "L_score": float(Lbest.get("score", -1.0) or -1.0)
    }
    return psoas, dbg

# =========================
# Ölçüm / Overlay
# =========================
def vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=None):
    pxA = px_area_mm2(ds)
    lo, hi = (fat_range if fat_range else CFG["HU_FAT"])
    fat_mask = hu_mask(hu, lo, hi)
    vfa_px = int(np.count_nonzero(cv2.bitwise_and(fat_mask, inner)))
    pma_px = int(np.count_nonzero(psoas_mask))
    VFA_mm2 = vfa_px * pxA
    PMA_mm2 = pma_px * pxA
    return VFA_mm2, PMA_mm2

def build_overlay(hu, inner, vertebra, vfa_mask, psoas_mask):
    base = normalize8(hu, -200, 300)
    base = cv2.cvtColor(base, cv2.COLOR_GRAY2BGR)
    base[inner == 0] = (base[inner == 0] * 0.25).astype(np.uint8)
    # VFA: yeşil, Psoas: sarı, Vertebra: kırmızı
    for (m, col, al) in ((vfa_mask, (0,255,0), 0.35), (psoas_mask, (0,255,255), 0.55), (vertebra, (255,0,0), 0.35)):
        if m is None: continue
        m_in = cv2.bitwise_and(m, inner)
        a = ((m_in > 0).astype(np.float32)) * al
        colimg = np.full_like(base, col, np.uint8)
        base = (base * (1 - a[..., None]) + colimg * a[..., None]).astype(np.uint8)
    # kontur çiz
    for m, c in ((vfa_mask, (0,255,0)), (psoas_mask, (0,255,255))):
        m_in = cv2.bitwise_and(m, inner)
        cnts, _ = cv2.findContours((m_in > 0).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cv2.drawContours(base, cnts, -1, c, 2, lineType=cv2.LINE_AA)
    return base

# =========================
# Ana dış API
# =========================
def run_case(dcm_path: Path, height_cm: float, sex: str, png_path: Optional[Path] = None) -> Tuple[Metrics, Optional[np.ndarray]]:
    """
    GUI’nin çağırdığı tek giriş noktası.
    DICOM zorunlu, PNG opsiyonel (aynı kesitse registration faydalı).
    """
    dcm_path = Path(dcm_path)
    ds = pydicom.dcmread(str(dcm_path))
    hu = load_hu(ds)

    png_gray = None
    if png_path and Path(png_path).exists():
        png_gray = cv2.imread(str(png_path), cv2.IMREAD_GRAYSCALE)

    # Fasya içi alan + vertebra
    inner, wall_ref, vb, _ = inner_abdomen_via_wall(hu, ds, png_gray=png_gray, png_band_mm=25, height_band_mm=80)

    # Psoas (anteromedial, posterior dışlama)
    psoas_mask, _dbg = find_psoas_inside(
        hu, ds, inner, vb,
        ring_inner_mm=CFG["RING_INNER_MM_BASE"],
        ring_outer_mm=CFG["RING_OUTER_MM_BASE"],
        grad_strength=CFG["GRAD_STRENGTH_BASE"],
        min_area_mm2=CFG["MIN_PSOAS_AREA_MM2_BASE"],
        max_area_mm2=CFG["MAX_PSOAS_AREA_MM2_BASE"]
    )

    # VFA/PMA
    VFA_mm2, PMA_mm2 = vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=CFG["HU_FAT"])
    VFA_cm2 = VFA_mm2 / 100.0
    ratio = (VFA_mm2 / PMA_mm2) if PMA_mm2 > 0 else None
    height_m = height_cm / 100.0
    PMI = (PMA_mm2 / 100.0) / (height_m**2) if height_m > 0 else None

    vfa_high = int(VFA_cm2 >= CFG["VFA_OBESITY_CUTOFF_CM2"])
    sarcopenia = int((PMI is not None) and (PMI < CFG["PMI_CUTOFF"][sex.upper()]))
    so_flag = int(bool(sarcopenia) and ((ratio is not None and ratio >= CFG["VFA_PSOAS_RATIO_CUTOFF"]) or vfa_high))

    # Overlay
    vfa_mask = cv2.bitwise_and(hu_mask(hu, *CFG["HU_FAT"]), inner)
    overlay = build_overlay(hu, inner, vb, vfa_mask, psoas_mask)

    res = Metrics(
        case_id=dcm_path.stem,
        sex=sex.upper(),
        height_m=height_m,
        PMA_mm2=float(round(PMA_mm2, 1)),
        VFA_mm2=float(round(VFA_mm2, 1)),
        ratio_VFA_PMA=(float(round(ratio, 2)) if ratio is not None else None),
        PMI_cm2_per_m2=(float(round(PMI, 2)) if PMI is not None else None),
        vfa_high=int(vfa_high),
        sarcopenia_pmi=int(sarcopenia),
        so_flag=int(so_flag),
    )
    return res, overlay
# -*- coding: utf-8 -*-
"""
L3 VFA / PMA / PMI – Core v3.7 (stabil, PMA fallback + VFA geri kazanım)
- DICOM zorunlu, PNG opsiyonel (aynı kesitse registration ile fasya kenarı güçlendirme)
- Fasya İÇİ VFA, anteromedial psoas seçimi (posterior dışlama), medial yakınlık, HU/şekil/eksen kısıtları
- PMA fallback: sıkı tarama başarısızsa gevşek tarama ile 0 kalmayı engeller
"""

from dataclasses import dataclass
from pathlib import Path
from typing import Optional, Tuple, Dict

import json
import math
import numpy as np
from pathlib import Path
DEBUG_DIR = Path.home() / 'Desktop' / 'L3_SO_ANALYSIS' / '_debug_out_FORCE'
DEBUG_DIR.mkdir(parents=True, exist_ok=True)
(Path(DEBUG_DIR/'import_marker.txt')).write_text('imported\n', encoding='utf-8')

__ULTRA_FORCE_ID__ = 'AO-3917'
print('[DEBUG] v3_7 LOADED', __ULTRA_FORCE_ID__, __file__)
print('[DEBUG] core file loaded:', __file__)
import cv2
import pydicom

# =========================
# Yapılandırma (override: settings.json)
# =========================
CFG = dict(
    # HU aralıkları
    HU_FAT=(-190, -30),
    HU_MUSCLE_BASE=(-29, 150),
    HU_MUSCLE_FALLBACK=(-60, 200),
    HU_BONE_SEED=(300, 3000),
    HU_BONE_CAND=(150, 2000),
    HU_BONE_EXCLUDE=(200, 4000),

    # Klinik eşikler
    PMI_CUTOFF={"M": 6.0, "F": 3.9},      # cm²/m²
    VFA_PSOAS_RATIO_CUTOFF=2.0,          # SO için yardımcı
    VFA_OBESITY_CUTOFF_CM2=100.0,        # cm²

    # Geometri / morfoloji
    RING_INNER_MM_BASE=6.0,
    RING_OUTER_MM_BASE=22.0,
    VERTEBRA_BUFFER_MM_BASE=3.0,
    MIN_PSOAS_AREA_MM2_BASE=150.0,
    MAX_PSOAS_AREA_MM2_BASE=2000.0,

    # Fasya kenar güçlendirme
    FASCIA_EDGE_Q=0.90,
    GRAD_STRENGTH_BASE=0.90,

    # Şekil / eksen kısıtları
    PSOAS_SHAPE_MIN_ECC=0.65,
    PSOAS_SHAPE_MIN_CONVEXITY=0.85,
    PSOAS_AXIS_MAX_DEG=25.0,

    # PNG registration
    PNG_REG_MAX_FEAT=2000,
    PNG_REG_GOOD_MATCH=80,
    PNG_REG_MIN_INLIERS=12,
)

# =========================
# Sonuç veri sınıfı
# =========================
@dataclass
class Metrics:
    case_id: str
    sex: str
    height_m: float
    PMA_mm2: float
    VFA_mm2: float
    ratio_VFA_PMA: Optional[float]
    PMI_cm2_per_m2: Optional[float]
    vfa_high: int
    sarcopenia_pmi: int
    so_flag: int  # (PMI<cutoff) and (VFA>=100cm2 or ratio>=2.0)

# =========================
# Ayar yükleme
# =========================
def load_settings(root_dir: Path):
    """settings.json varsa CFG’yi override eder."""
    sp = (root_dir / "settings.json")
    if sp.exists():
        try:
            data = json.loads(sp.read_text(encoding="utf-8"))
            for k, v in data.items():
                CFG[k] = v
            print(f"[INFO] settings.json yüklendi: {sp}")
        except Exception as e:
            print(f"[WARN] settings.json okunamadı: {e}")
        return res, overlay

# =========================
# DICOM / temel yardımcılar
# =========================
def load_hu(ds):
    arr = ds.pixel_array.astype(np.float32)
    slope = float(getattr(ds, "RescaleSlope", 1.0))
    inter = float(getattr(ds, "RescaleIntercept", 0.0))
    return arr * slope + inter

def pixel_spacing(ds) -> Tuple[float, float]:
    sp = getattr(ds, "PixelSpacing", None)
    if sp is None or len(sp) < 2:
        raise ValueError("PixelSpacing eksik.")
    return float(sp[0]), float(sp[1])

def px_area_mm2(ds) -> float:
    sy, sx = pixel_spacing(ds)
    return sy * sx

def mm_to_px(ds, mm: float) -> int:
    sy, sx = pixel_spacing(ds)
    s = (sy + sx) / 2.0
    return max(1, int(round(mm / max(1e-6, s))))

def area_px_from_mm2(ds, mm2: float) -> int:
    sy, sx = pixel_spacing(ds)
    return int(round(mm2 / (sy * sx + 1e-9)))

def hu_mask(hu, lo, hi):
    return ((hu >= lo) & (hu <= hi)).astype(np.uint8) * 255

def normalize8(hu, lo=-300, hi=300):
    img = np.clip(hu, lo, hi).astype(np.float32)
    return cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

def centroid(mask):
    m = (mask > 0).astype(np.uint8)
    if m.sum() == 0:
        return None
    M = cv2.moments(m)
    if M["m00"] == 0:
        return None
    return (M["m10"]/M["m00"], M["m01"]/M["m00"])

# =========================
# PNG ↔ DICOM registration (opsiyonel)
# =========================
def register_png_to_dicom(png_gray, dicom_gray):
    try:
        orb = cv2.ORB_create(nfeatures=CFG["PNG_REG_MAX_FEAT"], fastThreshold=5)
        k1, d1 = orb.detectAndCompute(png_gray, None)
        k2, d2 = orb.detectAndCompute(dicom_gray, None)
        if d1 is None or d2 is None or len(k1) < 20 or len(k2) < 20:
            return None
        bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=False)
        matches = bf.knnMatch(d1, d2, k=2)
        good = [m for m, n in matches if m.distance < 0.75 * n.distance]
        if len(good) < CFG["PNG_REG_GOOD_MATCH"]:
            return None
        src = np.float32([k1[m.queryIdx].pt for m in good]).reshape(-1, 1, 2)
        dst = np.float32([k2[m.trainIdx].pt for m in good]).reshape(-1, 1, 2)
        M, inliers = cv2.estimateAffine2D(src, dst, ransacReprojThreshold=3.0, confidence=0.99)
        if M is None or (inliers is not None and inliers.sum() < CFG["PNG_REG_MIN_INLIERS"]):
            return None
        return M
    except Exception:
        return None

def warp_png_with_affine(png_gray, shape_hw, M):
    h, w = shape_hw
    return cv2.warpAffine(png_gray, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)

# =========================
# Segmentasyon adımları
# =========================
def body_mask_from_hu(hu):
    img8 = normalize8(hu, -300, 300)
    img8 = cv2.GaussianBlur(img8, (7, 7), 0)
    _, th = cv2.threshold(img8, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    if np.mean(img8[th > 0]) < np.mean(img8[th == 0]):
        th = 255 - th
    th = cv2.morphologyEx(th, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 2)
    th = cv2.morphologyEx(th, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    return th

def vertebra_body_mask(hu):
    h, w = hu.shape
    cx, cy = w // 2, h // 2
    seed = hu_mask(hu, *CFG["HU_BONE_SEED"])
    cand = hu_mask(hu, *CFG["HU_BONE_CAND"])
    num, L, S, C = cv2.connectedComponentsWithStats(seed, 8)
    if num <= 1:
        return np.zeros_like(seed)
    minA, maxA = 0.001 * (h*w), 0.06 * (h*w)
    best, sc = 0, -1e9
    for lbl in range(1, num):
        x, y, ww, hh, a = S[lbl]
        if not (minA <= a <= maxA):
            continue
        mx, my = C[lbl]
        dist = math.hypot(mx - cx, my - cy)
        comp = (L == lbl).astype(np.uint8) * 255
        edges = cv2.Canny(comp, 0, 1)
        perim = float(np.count_nonzero(edges)) + 1e-6
        circ = 4.0 * np.pi * a / (perim * perim)
        s = a - 3.0 * dist + 5000.0 * circ
        if s > sc:
            best, sc = lbl, s
    if best == 0:
        return np.zeros_like(seed)
    seed_sel = (L == best).astype(np.uint8) * 255
    grown = cv2.bitwise_and(cand, cv2.dilate(seed_sel, np.ones((15, 15), np.uint8), 1))
    grown = cv2.morphologyEx(grown, cv2.MORPH_CLOSE, np.ones((11, 11), np.uint8), 2)
    grown = cv2.morphologyEx(grown, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    num2, L2, S2, _ = cv2.connectedComponentsWithStats(grown, 8)
    if num2 <= 1:
        return np.zeros_like(grown)
    best2, sc2 = 0, -1e9
    for lbl in range(1, num2):
        x, y, ww, hh, a = S2[lbl]
        mx, my = cv2.connectedComponentsWithStats(grown, 8)[3][lbl]
        dist = math.hypot(mx - cx, my - cy)
        s = a - 2.0 * dist
        if s > sc2:
            best2, sc2 = lbl, s
    vb = (L2 == best2).astype(np.uint8) * 255
    vb = cv2.morphologyEx(vb, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 1)
    return vb

def gradient_mask_u8(img8, ring, strength=0.85):
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    vals = mag[ring > 0]
    thr = np.percentile(vals, 100*strength) if vals.size >= 50 else np.percentile(mag, 90)
    g = (mag >= thr).astype(np.uint8) * 255
    return cv2.morphologyEx(g, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8), 1)

def refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=None):
    h, w = hu.shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    img8 = normalize8(hu, -200, 300)
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    thr = np.percentile(mag, CFG["FASCIA_EDGE_Q"]*100.0)
    wall_edges = (mag >= thr).astype(np.uint8)*255
    if png_edges is not None:
        wall_edges = cv2.bitwise_or(wall_edges, png_edges)
    wall_edges = cv2.bitwise_and(wall_edges, body_cc)

    gap = mm_to_px(ds, 6.0)
    wall_edges = cv2.morphologyEx(wall_edges, cv2.MORPH_CLOSE, np.ones((gap, gap), np.uint8), 1)

    wall_barrier = cv2.dilate(wall_edges, np.ones((3, 3), np.uint8), 1)
    barrier = cv2.bitwise_or(wall_barrier, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner2 = (tmp2 == 128).astype(np.uint8) * 255
    inner2 = cv2.bitwise_and(inner2, body_cc)
    inner2 = cv2.morphologyEx(inner2, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)
    return inner2, wall_edges

def inner_abdomen_via_wall(hu, ds, png_gray=None, png_band_mm=25, height_band_mm=80):
    body = body_mask_from_hu(hu)
    h, w = hu.shape
    vb = vertebra_body_mask(hu)
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    # body_cc (merkezle aynı komponent)
    num_b, Lb, _, _ = cv2.connectedComponentsWithStats((body > 0).astype(np.uint8), 8)
    body_cc = np.zeros_like(body)
    if num_b > 1:
        lbl = Lb[cy, cx]
        if lbl != 0:
            body_cc[Lb == lbl] = 255
    if body_cc.sum() == 0:
        body_cc = body

    # PNG kenarı (opsiyonel)
    png_edges = np.zeros_like(body_cc)
    if png_gray is not None:
        dicom8 = normalize8(hu, -200, 300)
        M = register_png_to_dicom(png_gray, dicom8)
        if M is not None:
            png_gray = warp_png_with_affine(png_gray, hu.shape, M)
        g = cv2.GaussianBlur(png_gray, (3, 3), 0)
        gx = cv2.Sobel(g, cv2.CV_32F, 1, 0, 3)
        gy = cv2.Sobel(g, cv2.CV_32F, 0, 1, 3)
        mag = cv2.magnitude(gx, gy)
        thr = np.percentile(mag, 88)
        full = (mag >= thr).astype(np.uint8) * 255
        band25 = mm_to_px(ds, png_band_mm)
        y1, y2 = max(0, cy - band25), min(h, cy + band25)
        png_edges[y1:y2, :] = full[y1:y2, :]
        png_edges = cv2.bitwise_and(png_edges, body_cc)

    # HU+gradient ile duvar
    img8 = normalize8(hu, -200, 300)
    sob = gradient_mask_u8(img8, body_cc, CFG["GRAD_STRENGTH_BASE"])
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    wall0 = cv2.bitwise_or(muscle, sob)
    wall0 = cv2.bitwise_or(wall0, png_edges)
    wall0 = cv2.bitwise_and(wall0, body_cc)

    # kaba inner
    wall = cv2.morphologyEx(wall0, cv2.MORPH_CLOSE,
                            np.ones((2*mm_to_px(ds, 5)+1, )*2, np.uint8), 1)
    wall = cv2.dilate(wall, np.ones((2*mm_to_px(ds, 2)+1, )*2, np.uint8), 1)
    barrier = cv2.bitwise_or(wall, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner = (tmp2 == 128).astype(np.uint8) * 255
    inner = cv2.bitwise_and(inner, body_cc)

    # aktif kontur rafinesi
    inner, wall_ref = refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=png_edges)

    # yükseklik bandı (L3 civarı)
    bandH = mm_to_px(ds, height_band_mm)
    y1, y2 = max(0, cy - bandH), min(h, cy + bandH)
    height_mask = np.zeros_like(inner); height_mask[y1:y2, :] = 255
    inner = cv2.bitwise_and(inner, height_mask)
    inner = cv2.morphologyEx(inner, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)

    # NOT: VFA düşmesin diye inner erozyonu UYGULAMIYORUZ (önceden kaldırıldı)
    return inner, wall_ref, vb, (cx, cy)

# =========================
# HU adaptasyonu / şekil skorları
# =========================
def adaptive_muscle_mask(hu, ring, base_range, fallback_range):
    vals = hu[ring > 0]
    vals = vals[(vals > fallback_range[0]) & (vals < fallback_range[1])]
    if vals.size >= 200:
        p10, p95 = np.percentile(vals, [10, 95])
        lo = max(fallback_range[0], min(base_range[0], p10 - 15))
        hi = min(fallback_range[1], max(base_range[1], p95 + 15))
        lo2 = max(fallback_range[0], min(lo, hi - 5))
        hi2 = min(fallback_range[1], max(hi, lo2 + 5))
        return hu_mask(hu, lo2, hi2), (float(lo2), float(hi2))
    return hu_mask(hu, *base_range), base_range

def shape_orientation_scores(comp_mask):
    m = (comp_mask > 0).astype(np.uint8)
    if cv2.countNonZero(m) == 0:
        return 0.0, 0.0, 0.0, 0.0
    cnts, _ = cv2.findContours(m, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return 0.0, 0.0, 0.0, 0.0
    cnt = max(cnts, key=cv2.contourArea)
    area = float(cv2.contourArea(cnt))
    hull = cv2.convexHull(cnt)
    hull_area = float(cv2.contourArea(hull)) + 1e-6
    convexity = max(0.0, min(1.0, area / hull_area))
    if len(cnt) >= 5:
        (_cx, _cy), (MA, ma), angle = cv2.fitEllipse(cnt)
        a = max(MA, ma) / 2.0
        b = max(1e-6, min(MA, ma) / 2.0)
        ecc = math.sqrt(max(0.0, 1.0 - (b*b)/(a*a)))
        axis_deg = float(angle)
    else:
        M = cv2.moments(cnt)
        if M["mu20"] + M["mu02"] == 0:
            ecc = 0.0; axis_deg = 0.0
        else:
            ang = 0.5 * math.atan2(2 * M["mu11"], (M["mu20"] - M["mu02"]))
            axis_deg = abs(np.degrees(ang))
            lam1 = (M["mu20"] + M["mu02"]) / 2 + math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            lam2 = (M["mu20"] + M["mu02"]) / 2 - math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            ecc = math.sqrt(max(0.0, 1.0 - (lam2+1e-6)/(lam1+1e-6)))
    # yataya yakınlık
    delta = min(abs(axis_deg - 0.0), abs(axis_deg - 180.0))
    axis_ok = 1.0 if delta <= CFG["PSOAS_AXIS_MAX_DEG"] else max(0.0, 1.0 - (delta - CFG["PSOAS_AXIS_MAX_DEG"])/CFG["PSOAS_AXIS_MAX_DEG"])
    ecc_ok = min(1.0, max(0.0, (ecc - CFG["PSOAS_SHAPE_MIN_ECC"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_ECC"] + 1e-6)))
    conv_ok = min(1.0, max(0.0, (convexity - CFG["PSOAS_SHAPE_MIN_CONVEXITY"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_CONVEXITY"] + 1e-6)))
    shape_score = 0.45*ecc_ok + 0.25*conv_ok + 0.30*axis_ok
    return float(ecc), float(convexity), float(axis_ok*100.0), float(shape_score)

# =========================
# (YENİ) PSOAS Yardımcıları + Bulucu
# =========================
def posterior_exclusion_mask(hu_shape, vb, ds, angle_right=(0,90), angle_left=(90,180)):
    """Posterior 180–360°’yi kapat, sağ/sol sektörleri üret."""
    h, w = hu_shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = cen
    yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
    dx, dy = xx - cx, cy - yy
    ang = (np.degrees(np.arctan2(dy, dx)) + 360.0) % 360.0
    R = ((ang >= angle_right[0]) & (ang <= angle_right[1])).astype(np.uint8)*255
    L = ((ang >= angle_left[0])  & (ang <= angle_left[1])).astype(np.uint8)*255
    POST = ((ang >= 180) & (ang < 360)).astype(np.uint8)*255
    return R, L, POST

def mediality_score(comp_mask, vb, ds, target_mm=10.0):
    inv_v = cv2.bitwise_not(vb)
    dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
    md = float(dist[comp_mask > 0].mean()) if cv2.countNonZero(comp_mask) else 1e9
    tgt_px = mm_to_px(ds, target_mm)
    if md <= 0 or tgt_px <= 0:
        return 0.0, md
    sc = max(0.0, min(1.0, (tgt_px / (md + 1e-6))))
    return sc, md

def refine_small_active_contour(mask):
    if mask is None or cv2.countNonZero(mask) == 0:
        return mask
    k = np.ones((3,3), np.uint8)
    out = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k, iterations=1)
    out = cv2.morphologyEx(out,  cv2.MORPH_OPEN,  k, iterations=1)
    return out

def find_psoas_inside(hu, ds, inner, vertebra,
                      ring_inner_mm=6.0, ring_outer_mm=22.0,
                      grad_strength=0.85,
                      min_area_mm2=150.0, max_area_mm2=2000.0):
    """
    Vertebranın anteromedialinde, fasya İÇİNDE psoas arar:
    - Sağ: 0–90°, Sol: 90–180°
    - Posterior 180–360° tamamen dışlanır
    - Vertebraya yakınlık (mediality), HU, şekil ve eksen kısıtları
    """
    h, w = hu.shape
    cen = centroid(vertebra)
    if cen is None:
        return np.zeros_like(vertebra), {"reason": "vertebra_not_found"}

    # Fasya içi halka
    i_px = mm_to_px(ds, ring_inner_mm)
    o_px = mm_to_px(ds, ring_outer_mm)
    dil_in  = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*i_px+1, 2*i_px+1)), 1)
    dil_out = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*o_px+1, 2*o_px+1)), 1)
    ring = cv2.bitwise_and(cv2.subtract(dil_out, dil_in), inner)

    # Sektörler
    Rsec, Lsec, POST = posterior_exclusion_mask(hu.shape, vertebra, ds)
    ring = cv2.bitwise_and(ring, cv2.bitwise_not(POST))

    # Aday kas maskesi
    img8 = normalize8(hu, -200, 300)
    gmask  = gradient_mask_u8(img8, ring, grad_strength)
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    base = cv2.bitwise_and(muscle, ring)
    base = cv2.bitwise_and(base, gmask)

    # Kemik + vertebra buffer dışı
    bone_ex = hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    base = cv2.bitwise_and(base, cv2.bitwise_not(bone_ex))
    base = cv2.bitwise_and(base, cv2.bitwise_not(vbuf))

    # Sağ/sol adaylar
    R_cand = cv2.bitwise_and(base, Rsec)
    L_cand = cv2.bitwise_and(base, Lsec)

    # Alan sınırları
    min_px = area_px_from_mm2(ds, min_area_mm2)
    max_px = area_px_from_mm2(ds, max_area_mm2)

    def pick_best(cand_mask):
        m = (cand_mask > 0).astype(np.uint8)
        num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
        best = {"mask": None, "area": 0, "md": 1e9, "shape": -1, "stats": None, "score": -1.0,
                "ecc":0.0, "conv":0.0, "axis_pct":0.0}
        if num <= 1:
            return best

        inv_v = cv2.bitwise_not(vertebra)
        dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)

        for lbl in range(1, num):
            comp = (L == lbl).astype(np.uint8)
            a = int(S[lbl, cv2.CC_STAT_AREA])
            if a < min_px or a > max_px:
                continue

            vals = hu[comp > 0]
            mean_hu, std_hu = float(vals.mean()), float(vals.std())
            if not (-10 <= mean_hu <= 80 and std_hu >= 8.0):
                continue

            # Medial yakınlık
            med_sc, md = mediality_score(comp, vertebra, ds, target_mm=10.0)
            if md < mm_to_px(ds, 3.0):  # vertebraya yapışık olmasın
                continue

            # Şekil/eksen
            ecc, conv, axis_pct, shape_sc = shape_orientation_scores(comp)
            axis_ok = axis_pct/100.0
            if axis_ok <= 0.2:
                continue

            # HU stabilitesi (yumuşak kriter)
            hu_stab = min(1.0, std_hu/15.0) * 0.5 + (1.0 - abs(mean_hu-40)/80.0)*0.5
            hu_stab = max(0.0, min(1.0, hu_stab))

            score = 0.45*med_sc + 0.35*shape_sc + 0.20*hu_stab
            if score > best["score"]:
                best.update({
                    "mask": comp*255, "area": a, "md": md, "shape": shape_sc,
                    "stats": (mean_hu, std_hu), "score": score,
                    "ecc": ecc, "conv": conv, "axis_pct": axis_pct
                })

        if best["mask"] is not None:
            best["mask"] = refine_small_active_contour(best["mask"])
        return best

    Rbest = pick_best(R_cand)
    Lbest = pick_best(L_cand)

    # --- Fallback: Eğer her iki taraf da bulunamadıysa, kriterleri gevşeterek tekrar dene
    if Rbest["mask"] is None and Lbest["mask"] is None:
        HU_SOFT = (-20, 100)
        base_soft = cv2.bitwise_and(hu_mask(hu, *HU_SOFT), ring)
        base_soft = cv2.bitwise_and(base_soft, cv2.bitwise_not(hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])))
        vbuf2 = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                        (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
        base_soft = cv2.bitwise_and(base_soft, cv2.bitwise_not(vbuf2))

        R_cand2 = cv2.bitwise_and(base_soft, Rsec)
        L_cand2 = cv2.bitwise_and(base_soft, Lsec)

        def pick_loose(cand_mask):
            m = (cand_mask > 0).astype(np.uint8)
            num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
            best = {"mask": None, "area": 0, "md": 1e9, "score": -1.0}
            if num <= 1:
                return best
            inv_v = cv2.bitwise_not(vertebra)
            dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
            min_px2 = area_px_from_mm2(ds, 80.0)
            max_px2 = area_px_from_mm2(ds, 3500.0)
            for lbl in range(1, num):
                comp = (L == lbl).astype(np.uint8)
                a = int(S[lbl, cv2.CC_STAT_AREA])
                if a < min_px2 or a > max_px2:
                    continue
                vals = hu[comp > 0]
                mean_hu, std_hu = float(vals.mean()), float(vals.std())
                if not (-20 <= mean_hu <= 100 and std_hu >= 5.0):
                    continue
                med_sc, md = mediality_score(comp, vertebra, ds, target_mm=12.0)
                if md < mm_to_px(ds, 2.0):
                    continue
                score = med_sc + std_hu/20.0
                if score > best["score"]:
                    best.update({"mask": comp*255, "area": a, "md": md, "score": score})
            if best["mask"] is not None:
                best["mask"] = refine_small_active_contour(best["mask"])
            return best

        Rbest2 = pick_loose(R_cand2)
        Lbest2 = pick_loose(L_cand2)
        if Rbest2["mask"] is not None: Rbest = Rbest2
        if Lbest2["mask"] is not None: Lbest = Lbest2

    psoas = np.zeros_like(vertebra)
    if Rbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Rbest["mask"])
    if Lbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Lbest["mask"])

    # Fasya içi ve vertebra buffer dışı garantisi
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    psoas = cv2.bitwise_and(psoas, inner)
    psoas = cv2.bitwise_and(psoas, cv2.bitwise_not(vbuf))

    dbg = {
        "R_area_px": int(Rbest.get("area", 0) or 0),
        "L_area_px": int(Lbest.get("area", 0) or 0),
        "R_mean_dist": float(Rbest.get("md", 0.0) or 0.0),
        "L_mean_dist": float(Lbest.get("md", 0.0) or 0.0),
        "R_stats": Rbest.get("stats"),
        "L_stats": Lbest.get("stats"),
        "Rshape": float(Rbest.get("shape", -1.0) or -1.0),
        "Lshape": float(Lbest.get("shape", -1.0) or -1.0),
        "R_score": float(Rbest.get("score", -1.0) or -1.0),
        "L_score": float(Lbest.get("score", -1.0) or -1.0)
    }
    return psoas, dbg

# =========================
# Ölçüm / Overlay
# =========================
def vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=None):
    pxA = px_area_mm2(ds)
    lo, hi = (fat_range if fat_range else CFG["HU_FAT"])
    fat_mask = hu_mask(hu, lo, hi)
    vfa_px = int(np.count_nonzero(cv2.bitwise_and(fat_mask, inner)))
    pma_px = int(np.count_nonzero(psoas_mask))
    VFA_mm2 = vfa_px * pxA
    PMA_mm2 = pma_px * pxA
    return VFA_mm2, PMA_mm2

def build_overlay(hu, inner, vertebra, vfa_mask, psoas_mask):
    base = normalize8(hu, -200, 300)
    base = cv2.cvtColor(base, cv2.COLOR_GRAY2BGR)
    base[inner == 0] = (base[inner == 0] * 0.25).astype(np.uint8)
    # VFA: yeşil, Psoas: sarı, Vertebra: kırmızı
    for (m, col, al) in ((vfa_mask, (0,255,0), 0.35), (psoas_mask, (0,255,255), 0.55), (vertebra, (255,0,0), 0.35)):
        if m is None: continue
        m_in = cv2.bitwise_and(m, inner)
        a = ((m_in > 0).astype(np.float32)) * al
        colimg = np.full_like(base, col, np.uint8)
        base = (base * (1 - a[..., None]) + colimg * a[..., None]).astype(np.uint8)
    # kontur çiz
    for m, c in ((vfa_mask, (0,255,0)), (psoas_mask, (0,255,255))):
        m_in = cv2.bitwise_and(m, inner)
        cnts, _ = cv2.findContours((m_in > 0).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cv2.drawContours(base, cnts, -1, c, 2, lineType=cv2.LINE_AA)
    return base

# =========================
# Ana dış API
# =========================
def run_case(dcm_path: Path, height_cm: float, sex: str, png_path: Optional[Path] = None) -> Tuple[Metrics, Optional[np.ndarray]]:
    """
    GUI’nin çağırdığı tek giriş noktası.
    DICOM zorunlu, PNG opsiyonel (aynı kesitse registration faydalı).
    """
    dcm_path = Path(dcm_path)
    ds = pydicom.dcmread(str(dcm_path))
    hu = load_hu(ds)

    png_gray = None
    if png_path and Path(png_path).exists():
        png_gray = cv2.imread(str(png_path), cv2.IMREAD_GRAYSCALE)

    # Fasya içi alan + vertebra
    inner, wall_ref, vb, _ = inner_abdomen_via_wall(hu, ds, png_gray=png_gray, png_band_mm=25, height_band_mm=80)

    # Psoas (anteromedial, posterior dışlama)
    psoas_mask, _dbg = find_psoas_inside(
        hu, ds, inner, vb,
        ring_inner_mm=CFG["RING_INNER_MM_BASE"],
        ring_outer_mm=CFG["RING_OUTER_MM_BASE"],
        grad_strength=CFG["GRAD_STRENGTH_BASE"],
        min_area_mm2=CFG["MIN_PSOAS_AREA_MM2_BASE"],
        max_area_mm2=CFG["MAX_PSOAS_AREA_MM2_BASE"]
    )

    # VFA/PMA
    VFA_mm2, PMA_mm2 = vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=CFG["HU_FAT"])
    VFA_cm2 = VFA_mm2 / 100.0
    ratio = (VFA_mm2 / PMA_mm2) if PMA_mm2 > 0 else None
    height_m = height_cm / 100.0
    PMI = (PMA_mm2 / 100.0) / (height_m**2) if height_m > 0 else None

    vfa_high = int(VFA_cm2 >= CFG["VFA_OBESITY_CUTOFF_CM2"])
    sarcopenia = int((PMI is not None) and (PMI < CFG["PMI_CUTOFF"][sex.upper()]))
    so_flag = int(bool(sarcopenia) and ((ratio is not None and ratio >= CFG["VFA_PSOAS_RATIO_CUTOFF"]) or vfa_high))

    # Overlay
    vfa_mask = cv2.bitwise_and(hu_mask(hu, *CFG["HU_FAT"]), inner)
    overlay = build_overlay(hu, inner, vb, vfa_mask, psoas_mask)

    res = Metrics(
        case_id=dcm_path.stem,
        sex=sex.upper(),
        height_m=height_m,
        PMA_mm2=float(round(PMA_mm2, 1)),
        VFA_mm2=float(round(VFA_mm2, 1)),
        ratio_VFA_PMA=(float(round(ratio, 2)) if ratio is not None else None),
        PMI_cm2_per_m2=(float(round(PMI, 2)) if PMI is not None else None),
        vfa_high=int(vfa_high),
        sarcopenia_pmi=int(sarcopenia),
        so_flag=int(so_flag),
    )
    return res, overlay# -*- coding: utf-8 -*-
"""
L3 VFA / PMA / PMI – Core v3.7
- DICOM zorunlu, PNG opsiyonel (aynı kesit registration)
- Fasya içi VFA, anteromedial psoas seçimi (posterior dışlama)
- Sağ: 0–90°, Sol: 90–180°, posterior 180–360° dışlanır
- Vertebra merkezli ring aralığı (6–22 mm), medial yakınlık, HU/şekil/eksen kısıtları
"""

from dataclasses import dataclass
from pathlib import Path
from typing import Optional, Tuple, Dict

import json
import math
import numpy as np
from pathlib import Path
DEBUG_DIR = Path.home() / 'Desktop' / 'L3_SO_ANALYSIS' / '_debug_out_FORCE'
DEBUG_DIR.mkdir(parents=True, exist_ok=True)
(Path(DEBUG_DIR/'import_marker.txt')).write_text('imported\n', encoding='utf-8')

__ULTRA_FORCE_ID__ = 'AO-3917'
print('[DEBUG] v3_7 LOADED', __ULTRA_FORCE_ID__, __file__)
print('[DEBUG] core file loaded:', __file__)
import cv2
import pydicom

# =========================
# Yapılandırma (override: settings.json)
# =========================
CFG = dict(
    # HU aralıkları
    HU_FAT=(-190, -30),
    HU_MUSCLE_BASE=(-29, 150),
    HU_MUSCLE_FALLBACK=(-60, 200),
    HU_BONE_SEED=(300, 3000),
    HU_BONE_CAND=(150, 2000),
    HU_BONE_EXCLUDE=(200, 4000),

    # Eşikler / klinik cut-off
    PMI_CUTOFF={"M": 6.0, "F": 3.9},      # cm²/m²
    VFA_PSOAS_RATIO_CUTOFF=2.0,          # SO için yardımcı
    VFA_OBESITY_CUTOFF_CM2=100.0,        # cm²

    # Geometri / morfoloji
    RING_INNER_MM_BASE=6.0,
    RING_OUTER_MM_BASE=22.0,
    VERTEBRA_BUFFER_MM_BASE=3.0,
    MIN_PSOAS_AREA_MM2_BASE=150.0,
    MAX_PSOAS_AREA_MM2_BASE=2000.0,

    # Fasya kenar güçlendirme
    FASCIA_EDGE_Q=0.90,
    GRAD_STRENGTH_BASE=0.90,

    # Şekil / eksen kısıtları
    PSOAS_SHAPE_MIN_ECC=0.65,
    PSOAS_SHAPE_MIN_CONVEXITY=0.85,
    PSOAS_AXIS_MAX_DEG=25.0,

    # PNG registration
    PNG_REG_MAX_FEAT=2000,
    PNG_REG_GOOD_MATCH=80,
    PNG_REG_MIN_INLIERS=12,
)

# =========================
# Sonuç veri sınıfı
# =========================
@dataclass
class Metrics:
    case_id: str
    sex: str
    height_m: float
    PMA_mm2: float
    VFA_mm2: float
    ratio_VFA_PMA: Optional[float]
    PMI_cm2_per_m2: Optional[float]
    vfa_high: int
    sarcopenia_pmi: int
    so_flag: int  # (PMI<cutoff) and (VFA>=100cm2 or ratio>=2.0)

# =========================
# Ayar yükleme
# =========================
def load_settings(root_dir: Path):
    """settings.json varsa CFG’yi override eder."""
    sp = (root_dir / "settings.json")
    if sp.exists():
        try:
            data = json.loads(sp.read_text(encoding="utf-8"))
            for k, v in data.items():
                CFG[k] = v
            print(f"[INFO] settings.json yüklendi: {sp}")
        except Exception as e:
            print(f"[WARN] settings.json okunamadı: {e}")
        return res, overlay

# =========================
# DICOM / temel yardımcılar
# =========================
def load_hu(ds):
    arr = ds.pixel_array.astype(np.float32)
    slope = float(getattr(ds, "RescaleSlope", 1.0))
    inter = float(getattr(ds, "RescaleIntercept", 0.0))
    return arr * slope + inter

def pixel_spacing(ds) -> Tuple[float, float]:
    sp = getattr(ds, "PixelSpacing", None)
    if sp is None or len(sp) < 2:
        raise ValueError("PixelSpacing eksik.")
    return float(sp[0]), float(sp[1])

def px_area_mm2(ds) -> float:
    sy, sx = pixel_spacing(ds)
    return sy * sx

def mm_to_px(ds, mm: float) -> int:
    sy, sx = pixel_spacing(ds)
    s = (sy + sx) / 2.0
    return max(1, int(round(mm / max(1e-6, s))))

def area_px_from_mm2(ds, mm2: float) -> int:
    sy, sx = pixel_spacing(ds)
    return int(round(mm2 / (sy * sx + 1e-9)))

def hu_mask(hu, lo, hi):
    return ((hu >= lo) & (hu <= hi)).astype(np.uint8) * 255

def normalize8(hu, lo=-300, hi=300):
    img = np.clip(hu, lo, hi).astype(np.float32)
    return cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

def centroid(mask):
    m = (mask > 0).astype(np.uint8)
    if m.sum() == 0:
        return None
    M = cv2.moments(m)
    if M["m00"] == 0:
        return None
    return (M["m10"]/M["m00"], M["m01"]/M["m00"])

# =========================
# PNG ↔ DICOM registration (opsiyonel)
# =========================
def register_png_to_dicom(png_gray, dicom_gray):
    try:
        orb = cv2.ORB_create(nfeatures=CFG["PNG_REG_MAX_FEAT"], fastThreshold=5)
        k1, d1 = orb.detectAndCompute(png_gray, None)
        k2, d2 = orb.detectAndCompute(dicom_gray, None)
        if d1 is None or d2 is None or len(k1) < 20 or len(k2) < 20:
            return None
        bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=False)
        matches = bf.knnMatch(d1, d2, k=2)
        good = [m for m, n in matches if m.distance < 0.75 * n.distance]
        if len(good) < CFG["PNG_REG_GOOD_MATCH"]:
            return None
        src = np.float32([k1[m.queryIdx].pt for m in good]).reshape(-1, 1, 2)
        dst = np.float32([k2[m.trainIdx].pt for m in good]).reshape(-1, 1, 2)
        M, inliers = cv2.estimateAffine2D(src, dst, ransacReprojThreshold=3.0, confidence=0.99)
        if M is None or (inliers is not None and inliers.sum() < CFG["PNG_REG_MIN_INLIERS"]):
            return None
        return M
    except Exception:
        return None

def warp_png_with_affine(png_gray, shape_hw, M):
    h, w = shape_hw
    return cv2.warpAffine(png_gray, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)

# =========================
# Segmentasyon adımları
# =========================
def body_mask_from_hu(hu):
    img8 = normalize8(hu, -300, 300)
    img8 = cv2.GaussianBlur(img8, (7, 7), 0)
    _, th = cv2.threshold(img8, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    if np.mean(img8[th > 0]) < np.mean(img8[th == 0]):
        th = 255 - th
    th = cv2.morphologyEx(th, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 2)
    th = cv2.morphologyEx(th, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    return th

def vertebra_body_mask(hu):
    h, w = hu.shape
    cx, cy = w // 2, h // 2
    seed = hu_mask(hu, *CFG["HU_BONE_SEED"])
    cand = hu_mask(hu, *CFG["HU_BONE_CAND"])
    num, L, S, C = cv2.connectedComponentsWithStats(seed, 8)
    if num <= 1:
        return np.zeros_like(seed)
    minA, maxA = 0.001 * (h*w), 0.06 * (h*w)
    best, sc = 0, -1e9
    for lbl in range(1, num):
        x, y, ww, hh, a = S[lbl]
        if not (minA <= a <= maxA):
            continue
        mx, my = C[lbl]
        dist = math.hypot(mx - cx, my - cy)
        comp = (L == lbl).astype(np.uint8) * 255
        edges = cv2.Canny(comp, 0, 1)
        perim = float(np.count_nonzero(edges)) + 1e-6
        circ = 4.0 * np.pi * a / (perim * perim)
        s = a - 3.0 * dist + 5000.0 * circ
        if s > sc:
            best, sc = lbl, s
    if best == 0:
        return np.zeros_like(seed)
    seed_sel = (L == best).astype(np.uint8) * 255
    grown = cv2.bitwise_and(cand, cv2.dilate(seed_sel, np.ones((15, 15), np.uint8), 1))
    grown = cv2.morphologyEx(grown, cv2.MORPH_CLOSE, np.ones((11, 11), np.uint8), 2)
    grown = cv2.morphologyEx(grown, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    num2, L2, S2, _ = cv2.connectedComponentsWithStats(grown, 8)
    if num2 <= 1:
        return np.zeros_like(grown)
    best2, sc2 = 0, -1e9
    for lbl in range(1, num2):
        x, y, ww, hh, a = S2[lbl]
        mx, my = cv2.connectedComponentsWithStats(grown, 8)[3][lbl]
        dist = math.hypot(mx - cx, my - cy)
        s = a - 2.0 * dist
        if s > sc2:
            best2, sc2 = lbl, s
    vb = (L2 == best2).astype(np.uint8) * 255
    vb = cv2.morphologyEx(vb, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 1)
    return vb

def gradient_mask_u8(img8, ring, strength=0.85):
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    vals = mag[ring > 0]
    if vals.size >= 50:
        thr = np.percentile(vals, 100*strength)
    else:
        thr = np.percentile(mag, 90)
    g = (mag >= thr).astype(np.uint8) * 255
    return cv2.morphologyEx(g, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8), 1)

def refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=None):
    h, w = hu.shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    img8 = normalize8(hu, -200, 300)
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    thr = np.percentile(mag, CFG["FASCIA_EDGE_Q"]*100.0)
    wall_edges = (mag >= thr).astype(np.uint8)*255
    if png_edges is not None:
        wall_edges = cv2.bitwise_or(wall_edges, png_edges)
    wall_edges = cv2.bitwise_and(wall_edges, body_cc)

    gap = mm_to_px(ds, 6.0)
    wall_edges = cv2.morphologyEx(wall_edges, cv2.MORPH_CLOSE, np.ones((gap, gap), np.uint8), 1)

    wall_barrier = cv2.dilate(wall_edges, np.ones((3, 3), np.uint8), 1)
    barrier = cv2.bitwise_or(wall_barrier, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner2 = (tmp2 == 128).astype(np.uint8) * 255
    inner2 = cv2.bitwise_and(inner2, body_cc)
    inner2 = cv2.morphologyEx(inner2, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)
    return inner2, wall_edges

def inner_abdomen_via_wall(hu, ds, png_gray=None, png_band_mm=25, height_band_mm=80):
    body = body_mask_from_hu(hu)
    h, w = hu.shape
    vb = vertebra_body_mask(hu)
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    # body_cc (merkezle aynı komponent)
    num_b, Lb, _, _ = cv2.connectedComponentsWithStats((body > 0).astype(np.uint8), 8)
    body_cc = np.zeros_like(body)
    if num_b > 1:
        lbl = Lb[cy, cx]
        if lbl != 0:
            body_cc[Lb == lbl] = 255
    if body_cc.sum() == 0:
        body_cc = body

    # PNG kenarı (opsiyonel)
    png_edges = np.zeros_like(body_cc)
    if png_gray is not None:
        dicom8 = normalize8(hu, -200, 300)
        M = register_png_to_dicom(png_gray, dicom8)
        if M is not None:
            png_gray = warp_png_with_affine(png_gray, hu.shape, M)
        g = cv2.GaussianBlur(png_gray, (3, 3), 0)
        gx = cv2.Sobel(g, cv2.CV_32F, 1, 0, 3)
        gy = cv2.Sobel(g, cv2.CV_32F, 0, 1, 3)
        mag = cv2.magnitude(gx, gy)
        thr = np.percentile(mag, 88)
        full = (mag >= thr).astype(np.uint8) * 255
        band25 = mm_to_px(ds, png_band_mm)
        y1, y2 = max(0, cy - band25), min(h, cy + band25)
        png_edges[y1:y2, :] = full[y1:y2, :]
        png_edges = cv2.bitwise_and(png_edges, body_cc)

    # HU+gradient ile duvar
    img8 = normalize8(hu, -200, 300)
    sob = gradient_mask_u8(img8, body_cc, CFG["GRAD_STRENGTH_BASE"])
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    wall0 = cv2.bitwise_or(muscle, sob)
    wall0 = cv2.bitwise_or(wall0, png_edges)
    wall0 = cv2.bitwise_and(wall0, body_cc)

    # kaba inner
    wall = cv2.morphologyEx(wall0, cv2.MORPH_CLOSE,
                            np.ones((2*mm_to_px(ds, 5)+1, )*2, np.uint8), 1)
    wall = cv2.dilate(wall, np.ones((2*mm_to_px(ds, 2)+1, )*2, np.uint8), 1)
    barrier = cv2.bitwise_or(wall, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner = (tmp2 == 128).astype(np.uint8) * 255
    inner = cv2.bitwise_and(inner, body_cc)

    # aktif kontur rafinesi
    inner, wall_ref = refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=png_edges)

    # yükseklik bandı (L3 civarı)
    bandH = mm_to_px(ds, height_band_mm)
    y1, y2 = max(0, cy - bandH), min(h, cy + bandH)
    height_mask = np.zeros_like(inner); height_mask[y1:y2, :] = 255
    inner = cv2.bitwise_and(inner, height_mask)
    inner = cv2.morphologyEx(inner, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)
    return inner, wall_ref, vb, (cx, cy)

# =========================
# HU adaptasyonu / şekil skorları
# =========================
def adaptive_muscle_mask(hu, ring, base_range, fallback_range):
    vals = hu[ring > 0]
    vals = vals[(vals > fallback_range[0]) & (vals < fallback_range[1])]
    if vals.size >= 200:
        p10, p95 = np.percentile(vals, [10, 95])
        lo = max(fallback_range[0], min(base_range[0], p10 - 15))
        hi = min(fallback_range[1], max(base_range[1], p95 + 15))
        lo2 = max(fallback_range[0], min(lo, hi - 5))
        hi2 = min(fallback_range[1], max(hi, lo2 + 5))
        return hu_mask(hu, lo2, hi2), (float(lo2), float(hi2))
    return hu_mask(hu, *base_range), base_range

def shape_orientation_scores(comp_mask):
    m = (comp_mask > 0).astype(np.uint8)
    if cv2.countNonZero(m) == 0:
        return 0.0, 0.0, 0.0, 0.0
    cnts, _ = cv2.findContours(m, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return 0.0, 0.0, 0.0, 0.0
    cnt = max(cnts, key=cv2.contourArea)
    area = float(cv2.contourArea(cnt))
    hull = cv2.convexHull(cnt)
    hull_area = float(cv2.contourArea(hull)) + 1e-6
    convexity = max(0.0, min(1.0, area / hull_area))
    if len(cnt) >= 5:
        (_cx, _cy), (MA, ma), angle = cv2.fitEllipse(cnt)
        a = max(MA, ma) / 2.0
        b = max(1e-6, min(MA, ma) / 2.0)
        ecc = math.sqrt(max(0.0, 1.0 - (b*b)/(a*a)))
        axis_deg = float(angle)
    else:
        M = cv2.moments(cnt)
        if M["mu20"] + M["mu02"] == 0:
            ecc = 0.0; axis_deg = 0.0
        else:
            ang = 0.5 * math.atan2(2 * M["mu11"], (M["mu20"] - M["mu02"]))
            axis_deg = abs(np.degrees(ang))
            lam1 = (M["mu20"] + M["mu02"]) / 2 + math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            lam2 = (M["mu20"] + M["mu02"]) / 2 - math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            ecc = math.sqrt(max(0.0, 1.0 - (lam2+1e-6)/(lam1+1e-6)))
    # yataya yakınlık
    delta = min(abs(axis_deg - 0.0), abs(axis_deg - 180.0))
    axis_ok = 1.0 if delta <= CFG["PSOAS_AXIS_MAX_DEG"] else max(0.0, 1.0 - (delta - CFG["PSOAS_AXIS_MAX_DEG"])/CFG["PSOAS_AXIS_MAX_DEG"])
    ecc_ok = min(1.0, max(0.0, (ecc - CFG["PSOAS_SHAPE_MIN_ECC"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_ECC"] + 1e-6)))
    conv_ok = min(1.0, max(0.0, (convexity - CFG["PSOAS_SHAPE_MIN_CONVEXITY"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_CONVEXITY"] + 1e-6)))
    shape_score = 0.45*ecc_ok + 0.25*conv_ok + 0.30*axis_ok
    return float(ecc), float(convexity), float(axis_ok*100.0), float(shape_score)

# =========================
# (YENİ) PSOAS Yardımcıları + Bulucu
# =========================
def posterior_exclusion_mask(hu_shape, vb, ds, angle_right=(0,90), angle_left=(90,180)):
    """Posterior 180–360°’yi kapat, sağ/sol sektörleri üret."""
    h, w = hu_shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = cen
    yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
    dx, dy = xx - cx, cy - yy
    ang = (np.degrees(np.arctan2(dy, dx)) + 360.0) % 360.0
    R = ((ang >= angle_right[0]) & (ang <= angle_right[1])).astype(np.uint8)*255
    L = ((ang >= angle_left[0])  & (ang <= angle_left[1])).astype(np.uint8)*255
    POST = ((ang >= 180) & (ang < 360)).astype(np.uint8)*255
    return R, L, POST

def mediality_score(comp_mask, vb, ds, target_mm=10.0):
    inv_v = cv2.bitwise_not(vb)
    dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
    md = float(dist[comp_mask > 0].mean()) if cv2.countNonZero(comp_mask) else 1e9
    tgt_px = mm_to_px(ds, target_mm)
    if md <= 0 or tgt_px <= 0:
        return 0.0, md
    sc = max(0.0, min(1.0, (tgt_px / (md + 1e-6))))
    return sc, md

def refine_small_active_contour(mask):
    if mask is None or cv2.countNonZero(mask) == 0:
        return mask
    k = np.ones((3,3), np.uint8)
    out = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k, iterations=1)
    out = cv2.morphologyEx(out,  cv2.MORPH_OPEN,  k, iterations=1)
    return out

def find_psoas_inside(hu, ds, inner, vertebra,
                      ring_inner_mm=6.0, ring_outer_mm=22.0,
                      grad_strength=0.85,
                      min_area_mm2=150.0, max_area_mm2=2000.0):
    """
    Vertebranın anteromedialinde, fasya İÇİNDE psoas arar:
    - Sağ: 0–90°, Sol: 90–180°
    - Posterior 180–360° tamamen dışlanır
    - Vertebraya yakınlık (mediality), HU, şekil ve eksen kısıtları
    """
    h, w = hu.shape
    cen = centroid(vertebra)
    if cen is None:
        return np.zeros_like(vertebra), {"reason": "vertebra_not_found"}
    cx, cy = int(cen[0]), int(cen[1])

    # Fasya içi halka
    i_px = mm_to_px(ds, ring_inner_mm)
    o_px = mm_to_px(ds, ring_outer_mm)
    dil_in  = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*i_px+1, 2*i_px+1)), 1)
    dil_out = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*o_px+1, 2*o_px+1)), 1)
    ring = cv2.bitwise_and(cv2.subtract(dil_out, dil_in), inner)

    # Sektörler
    Rsec, Lsec, POST = posterior_exclusion_mask(hu.shape, vertebra, ds)
    ring = cv2.bitwise_and(ring, cv2.bitwise_not(POST))

    # Aday kas maskesi
    img8 = normalize8(hu, -200, 300)
    gmask  = gradient_mask_u8(img8, ring, grad_strength)
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    base = cv2.bitwise_and(muscle, ring)
    base = cv2.bitwise_and(base, gmask)

    # Kemik + vertebra buffer dışı
    bone_ex = hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    base = cv2.bitwise_and(base, cv2.bitwise_not(bone_ex))
    base = cv2.bitwise_and(base, cv2.bitwise_not(vbuf))

    # Sağ/sol adaylar
    R_cand = cv2.bitwise_and(base, Rsec)
    L_cand = cv2.bitwise_and(base, Lsec)

    # Alan sınırları
    min_px = area_px_from_mm2(ds, min_area_mm2)
    max_px = area_px_from_mm2(ds, max_area_mm2)

    def pick_best(cand_mask):
        m = (cand_mask > 0).astype(np.uint8)
        num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
        best = {"mask": None, "area": 0, "md": 1e9, "shape": -1, "stats": None, "score": -1.0,
                "ecc":0.0, "conv":0.0, "axis_pct":0.0}
        if num <= 1:
            return best

        inv_v = cv2.bitwise_not(vertebra)
        dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)

        for lbl in range(1, num):
            comp = (L == lbl).astype(np.uint8)
            a = int(S[lbl, cv2.CC_STAT_AREA])
            if a < min_px or a > max_px:
                continue

            vals = hu[comp > 0]
            mean_hu, std_hu = float(vals.mean()), float(vals.std())
            if not (-10 <= mean_hu <= 80 and std_hu >= 8.0):
                continue

            # Medial yakınlık
            med_sc, md = mediality_score(comp, vertebra, ds, target_mm=10.0)
            if md < mm_to_px(ds, 3.0):  # vertebraya yapışık olmasın
                continue

            # Şekil/eksen
            ecc, conv, axis_pct, shape_sc = shape_orientation_scores(comp)
            axis_ok = axis_pct/100.0
            if axis_ok <= 0.2:
                continue

            # HU stabilitesi (yumuşak kriter)
            hu_stab = min(1.0, std_hu/15.0) * 0.5 + (1.0 - abs(mean_hu-40)/80.0)*0.5
            hu_stab = max(0.0, min(1.0, hu_stab))

            score = 0.45*med_sc + 0.35*shape_sc + 0.20*hu_stab
            if score > best["score"]:
                best.update({
                    "mask": comp*255, "area": a, "md": md, "shape": shape_sc,
                    "stats": (mean_hu, std_hu), "score": score,
                    "ecc": ecc, "conv": conv, "axis_pct": axis_pct
                })

        if best["mask"] is not None:
            best["mask"] = refine_small_active_contour(best["mask"])
        return best

    Rbest = pick_best(R_cand)
    Lbest = pick_best(L_cand)

    psoas = np.zeros_like(vertebra)
    if Rbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Rbest["mask"])
    if Lbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Lbest["mask"])

    # Fasya içi ve vertebra buffer dışı garantisi
    psoas = cv2.bitwise_and(psoas, inner)
    psoas = cv2.bitwise_and(psoas, cv2.bitwise_not(vbuf))

    dbg = {
        "R_area_px": Rbest["area"], "L_area_px": Lbest["area"],
        "R_mean_dist": Rbest["md"], "L_mean_dist": Lbest["md"],
        "R_stats": Rbest["stats"], "L_stats": Lbest["stats"],
        "Rshape": Rbest["shape"], "Lshape": Lbest["shape"],
        "Rshape_dbg": (Rbest["ecc"], Rbest["conv"], Rbest["axis_pct"]),
        "Lshape_dbg": (Lbest["ecc"], Lbest["conv"], Lbest["axis_pct"]),
        "R_score": Rbest["score"], "L_score": Lbest["score"]
    }
    return psoas, dbg

# =========================
# Ölçüm / Overlay
# =========================
def vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=None):
    pxA = px_area_mm2(ds)
    lo, hi = (fat_range if fat_range else CFG["HU_FAT"])
    fat_mask = hu_mask(hu, lo, hi)
    vfa_px = int(np.count_nonzero(cv2.bitwise_and(fat_mask, inner)))
    pma_px = int(np.count_nonzero(psoas_mask))
    VFA_mm2 = vfa_px * pxA
    PMA_mm2 = pma_px * pxA
    return VFA_mm2, PMA_mm2

def build_overlay(hu, inner, vertebra, vfa_mask, psoas_mask):
    base = normalize8(hu, -200, 300)
    base = cv2.cvtColor(base, cv2.COLOR_GRAY2BGR)
    base[inner == 0] = (base[inner == 0] * 0.25).astype(np.uint8)
    # VFA: yeşil, Psoas: sarı, Vertebra: kırmızı
    for (m, col, al) in ((vfa_mask, (0,255,0), 0.35), (psoas_mask, (0,255,255), 0.55), (vertebra, (255,0,0), 0.35)):
        if m is None: continue
        m_in = cv2.bitwise_and(m, inner)
        a = ((m_in > 0).astype(np.float32)) * al
        colimg = np.full_like(base, col, np.uint8)
        base = (base * (1 - a[..., None]) + colimg * a[..., None]).astype(np.uint8)
    # kontur çiz
    for m, c in ((vfa_mask, (0,255,0)), (psoas_mask, (0,255,255))):
        m_in = cv2.bitwise_and(m, inner)
        cnts, _ = cv2.findContours((m_in > 0).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cv2.drawContours(base, cnts, -1, c, 2, lineType=cv2.LINE_AA)
    return base

# =========================
# Ana dış API
# =========================
def run_case(dcm_path: Path, height_cm: float, sex: str, png_path: Optional[Path] = None) -> Tuple[Metrics, Optional[np.ndarray]]:
    """
    GUI’nin çağırdığı tek giriş noktası.
    DICOM zorunlu, PNG opsiyonel (aynı kesitse registration faydalı).
    """
    dcm_path = Path(dcm_path)
    ds = pydicom.dcmread(str(dcm_path))
    hu = load_hu(ds)

    png_gray = None
    if png_path and Path(png_path).exists():
        png_gray = cv2.imread(str(png_path), cv2.IMREAD_GRAYSCALE)

    # Fasya içi alan + vertebra
    inner, wall_ref, vb, _ = inner_abdomen_via_wall(hu, ds, png_gray=png_gray, png_band_mm=25, height_band_mm=80)

    # Psoas (anteromedial, posterior dışlama)
    psoas_mask, _dbg = find_psoas_inside(
        hu, ds, inner, vb,
        ring_inner_mm=CFG["RING_INNER_MM_BASE"],
        ring_outer_mm=CFG["RING_OUTER_MM_BASE"],
        grad_strength=CFG["GRAD_STRENGTH_BASE"],
        min_area_mm2=CFG["MIN_PSOAS_AREA_MM2_BASE"],
        max_area_mm2=CFG["MAX_PSOAS_AREA_MM2_BASE"]
    )

    # VFA/PMA
    VFA_mm2, PMA_mm2 = vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=CFG["HU_FAT"])
    VFA_cm2 = VFA_mm2 / 100.0
    ratio = (VFA_mm2 / PMA_mm2) if PMA_mm2 > 0 else None
    height_m = height_cm / 100.0
    PMI = (PMA_mm2 / 100.0) / (height_m**2) if height_m > 0 else None

    vfa_high = int(VFA_cm2 >= CFG["VFA_OBESITY_CUTOFF_CM2"])
    sarcopenia = int((PMI is not None) and (PMI < CFG["PMI_CUTOFF"][sex.upper()]))
    so_flag = int(bool(sarcopenia) and ((ratio is not None and ratio >= CFG["VFA_PSOAS_RATIO_CUTOFF"]) or vfa_high))

    # Overlay
    vfa_mask = cv2.bitwise_and(hu_mask(hu, *CFG["HU_FAT"]), inner)
    overlay = build_overlay(hu, inner, vb, vfa_mask, psoas_mask)

    res = Metrics(
        case_id=dcm_path.stem,
        sex=sex.upper(),
        height_m=height_m,
        PMA_mm2=float(round(PMA_mm2, 1)),
        VFA_mm2=float(round(VFA_mm2, 1)),
        ratio_VFA_PMA=(float(round(ratio, 2)) if ratio is not None else None),
        PMI_cm2_per_m2=(float(round(PMI, 2)) if PMI is not None else None),
        vfa_high=int(vfa_high),
        sarcopenia_pmi=int(sarcopenia),
        so_flag=int(so_flag),
    )
    return res, overlay#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
L3 VFA / PMA / PMI – Core v3.7
- DICOM zorunlu, PNG opsiyonel (aynı kesit registration)
- Fasya içi VFA, anteromedial psoas seçimi (posterior dışlama)
- Sağ: 0–90°, Sol: 90–180°, posterior 180–360° dışlanır
- Vertebra merkezli ring aralığı (6–22 mm), medial yakınlık, HU/şekil/eksen kısıtları
"""

from dataclasses import dataclass
from pathlib import Path
from typing import Optional, Tuple, Dict

import json
import math
import numpy as np
from pathlib import Path
DEBUG_DIR = Path.home() / 'Desktop' / 'L3_SO_ANALYSIS' / '_debug_out_FORCE'
DEBUG_DIR.mkdir(parents=True, exist_ok=True)
(Path(DEBUG_DIR/'import_marker.txt')).write_text('imported\n', encoding='utf-8')

__ULTRA_FORCE_ID__ = 'AO-3917'
print('[DEBUG] v3_7 LOADED', __ULTRA_FORCE_ID__, __file__)
print('[DEBUG] core file loaded:', __file__)
import cv2
import pydicom

# =========================
# Yapılandırma (override: settings.json)
# =========================
CFG = dict(
    # HU aralıkları
    HU_FAT=(-190, -30),
    HU_MUSCLE_BASE=(-29, 150),
    HU_MUSCLE_FALLBACK=(-60, 200),
    HU_BONE_SEED=(300, 3000),
    HU_BONE_CAND=(150, 2000),
    HU_BONE_EXCLUDE=(200, 4000),

    # Eşikler / klinik cut-off
    PMI_CUTOFF={"M": 6.0, "F": 3.9},      # cm²/m²
    VFA_PSOAS_RATIO_CUTOFF=2.0,          # SO için yardımcı
    VFA_OBESITY_CUTOFF_CM2=100.0,        # cm²

    # Geometri / morfoloji
    RING_INNER_MM_BASE=6.0,
    RING_OUTER_MM_BASE=22.0,
    VERTEBRA_BUFFER_MM_BASE=3.0,
    MIN_PSOAS_AREA_MM2_BASE=150.0,
    MAX_PSOAS_AREA_MM2_BASE=2000.0,

    # Fasya kenar güçlendirme
    FASCIA_EDGE_Q=0.90,
    GRAD_STRENGTH_BASE=0.90,

    # Şekil / eksen kısıtları
    PSOAS_SHAPE_MIN_ECC=0.65,
    PSOAS_SHAPE_MIN_CONVEXITY=0.85,
    PSOAS_AXIS_MAX_DEG=25.0,

    # PNG registration
    PNG_REG_MAX_FEAT=2000,
    PNG_REG_GOOD_MATCH=80,
    PNG_REG_MIN_INLIERS=12,
)

# =========================
# Sonuç veri sınıfı
# =========================
@dataclass
class Metrics:
    case_id: str
    sex: str
    height_m: float
    PMA_mm2: float
    VFA_mm2: float
    ratio_VFA_PMA: Optional[float]
    PMI_cm2_per_m2: Optional[float]
    vfa_high: int
    sarcopenia_pmi: int
    so_flag: int  # (PMI<cutoff) and (VFA>=100cm2 or ratio>=2.0)

# =========================
# Ayar yükleme
# =========================
def load_settings(root_dir: Path):
    """settings.json varsa CFG’yi override eder."""
    sp = (root_dir / "settings.json")
    if sp.exists():
        try:
            data = json.loads(sp.read_text(encoding="utf-8"))
            for k, v in data.items():
                CFG[k] = v
            print(f"[INFO] settings.json yüklendi: {sp}")
        except Exception as e:
            print(f"[WARN] settings.json okunamadı: {e}")
        return res, overlay

# =========================
# DICOM / temel yardımcılar
# =========================
def load_hu(ds):
    arr = ds.pixel_array.astype(np.float32)
    slope = float(getattr(ds, "RescaleSlope", 1.0))
    inter = float(getattr(ds, "RescaleIntercept", 0.0))
    return arr * slope + inter

def pixel_spacing(ds) -> Tuple[float, float]:
    sp = getattr(ds, "PixelSpacing", None)
    if sp is None or len(sp) < 2:
        raise ValueError("PixelSpacing eksik.")
    return float(sp[0]), float(sp[1])

def px_area_mm2(ds) -> float:
    sy, sx = pixel_spacing(ds)
    return sy * sx

def mm_to_px(ds, mm: float) -> int:
    sy, sx = pixel_spacing(ds)
    s = (sy + sx) / 2.0
    return max(1, int(round(mm / max(1e-6, s))))

def area_px_from_mm2(ds, mm2: float) -> int:
    sy, sx = pixel_spacing(ds)
    return int(round(mm2 / (sy * sx + 1e-9)))

def hu_mask(hu, lo, hi):
    return ((hu >= lo) & (hu <= hi)).astype(np.uint8) * 255

def normalize8(hu, lo=-300, hi=300):
    img = np.clip(hu, lo, hi).astype(np.float32)
    return cv2.normalize(img, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

def centroid(mask):
    m = (mask > 0).astype(np.uint8)
    if m.sum() == 0:
        return None
    M = cv2.moments(m)
    if M["m00"] == 0:
        return None
    return (M["m10"]/M["m00"], M["m01"]/M["m00"])

# =========================
# PNG ↔ DICOM registration (opsiyonel)
# =========================
def register_png_to_dicom(png_gray, dicom_gray):
    try:
        orb = cv2.ORB_create(nfeatures=CFG["PNG_REG_MAX_FEAT"], fastThreshold=5)
        k1, d1 = orb.detectAndCompute(png_gray, None)
        k2, d2 = orb.detectAndCompute(dicom_gray, None)
        if d1 is None or d2 is None or len(k1) < 20 or len(k2) < 20:
            return None
        bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=False)
        matches = bf.knnMatch(d1, d2, k=2)
        good = [m for m, n in matches if m.distance < 0.75 * n.distance]
        if len(good) < CFG["PNG_REG_GOOD_MATCH"]:
            return None
        src = np.float32([k1[m.queryIdx].pt for m in good]).reshape(-1, 1, 2)
        dst = np.float32([k2[m.trainIdx].pt for m in good]).reshape(-1, 1, 2)
        M, inliers = cv2.estimateAffine2D(src, dst, ransacReprojThreshold=3.0, confidence=0.99)
        if M is None or (inliers is not None and inliers.sum() < CFG["PNG_REG_MIN_INLIERS"]):
            return None
        return M
    except Exception:
        return None

def warp_png_with_affine(png_gray, shape_hw, M):
    h, w = shape_hw
    return cv2.warpAffine(png_gray, M, (w, h), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)

# =========================
# Segmentasyon adımları
# =========================
def body_mask_from_hu(hu):
    img8 = normalize8(hu, -300, 300)
    img8 = cv2.GaussianBlur(img8, (7, 7), 0)
    _, th = cv2.threshold(img8, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    if np.mean(img8[th > 0]) < np.mean(img8[th == 0]):
        th = 255 - th
    th = cv2.morphologyEx(th, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 2)
    th = cv2.morphologyEx(th, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    return th

def vertebra_body_mask(hu):
    h, w = hu.shape
    cx, cy = w // 2, h // 2
    seed = hu_mask(hu, *CFG["HU_BONE_SEED"])
    cand = hu_mask(hu, *CFG["HU_BONE_CAND"])
    num, L, S, C = cv2.connectedComponentsWithStats(seed, 8)
    if num <= 1:
        return np.zeros_like(seed)
    minA, maxA = 0.001 * (h*w), 0.06 * (h*w)
    best, sc = 0, -1e9
    for lbl in range(1, num):
        x, y, ww, hh, a = S[lbl]
        if not (minA <= a <= maxA):
            continue
        mx, my = C[lbl]
        dist = math.hypot(mx - cx, my - cy)
        comp = (L == lbl).astype(np.uint8) * 255
        edges = cv2.Canny(comp, 0, 1)
        perim = float(np.count_nonzero(edges)) + 1e-6
        circ = 4.0 * np.pi * a / (perim * perim)
        s = a - 3.0 * dist + 5000.0 * circ
        if s > sc:
            best, sc = lbl, s
    if best == 0:
        return np.zeros_like(seed)
    seed_sel = (L == best).astype(np.uint8) * 255
    grown = cv2.bitwise_and(cand, cv2.dilate(seed_sel, np.ones((15, 15), np.uint8), 1))
    grown = cv2.morphologyEx(grown, cv2.MORPH_CLOSE, np.ones((11, 11), np.uint8), 2)
    grown = cv2.morphologyEx(grown, cv2.MORPH_OPEN,  np.ones((5, 5), np.uint8), 1)
    num2, L2, S2, _ = cv2.connectedComponentsWithStats(grown, 8)
    if num2 <= 1:
        return np.zeros_like(grown)
    best2, sc2 = 0, -1e9
    for lbl in range(1, num2):
        x, y, ww, hh, a = S2[lbl]
        mx, my = cv2.connectedComponentsWithStats(grown, 8)[3][lbl]
        dist = math.hypot(mx - cx, my - cy)
        s = a - 2.0 * dist
        if s > sc2:
            best2, sc2 = lbl, s
    vb = (L2 == best2).astype(np.uint8) * 255
    vb = cv2.morphologyEx(vb, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8), 1)
    return vb

def gradient_mask_u8(img8, ring, strength=0.85):
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    vals = mag[ring > 0]
    if vals.size >= 50:
        thr = np.percentile(vals, 100*strength)
    else:
        thr = np.percentile(mag, 90)
    g = (mag >= thr).astype(np.uint8) * 255
    return cv2.morphologyEx(g, cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8), 1)

def refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=None):
    h, w = hu.shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    img8 = normalize8(hu, -200, 300)
    gx = cv2.Sobel(img8, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(img8, cv2.CV_32F, 0, 1, 3)
    mag = cv2.magnitude(gx, gy)
    thr = np.percentile(mag, CFG["FASCIA_EDGE_Q"]*100.0)
    wall_edges = (mag >= thr).astype(np.uint8)*255
    if png_edges is not None:
        wall_edges = cv2.bitwise_or(wall_edges, png_edges)
    wall_edges = cv2.bitwise_and(wall_edges, body_cc)

    gap = mm_to_px(ds, 6.0)
    wall_edges = cv2.morphologyEx(wall_edges, cv2.MORPH_CLOSE, np.ones((gap, gap), np.uint8), 1)

    wall_barrier = cv2.dilate(wall_edges, np.ones((3, 3), np.uint8), 1)
    barrier = cv2.bitwise_or(wall_barrier, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner2 = (tmp2 == 128).astype(np.uint8) * 255
    inner2 = cv2.bitwise_and(inner2, body_cc)
    inner2 = cv2.morphologyEx(inner2, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)
    return inner2, wall_edges

def inner_abdomen_via_wall(hu, ds, png_gray=None, png_band_mm=25, height_band_mm=80):
    body = body_mask_from_hu(hu)
    h, w = hu.shape
    vb = vertebra_body_mask(hu)
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = int(cen[0]), int(cen[1])

    # body_cc (merkezle aynı komponent)
    num_b, Lb, _, _ = cv2.connectedComponentsWithStats((body > 0).astype(np.uint8), 8)
    body_cc = np.zeros_like(body)
    if num_b > 1:
        lbl = Lb[cy, cx]
        if lbl != 0:
            body_cc[Lb == lbl] = 255
    if body_cc.sum() == 0:
        body_cc = body

    # PNG kenarı (opsiyonel)
    png_edges = np.zeros_like(body_cc)
    if png_gray is not None:
        dicom8 = normalize8(hu, -200, 300)
        M = register_png_to_dicom(png_gray, dicom8)
        if M is not None:
            png_gray = warp_png_with_affine(png_gray, hu.shape, M)
        g = cv2.GaussianBlur(png_gray, (3, 3), 0)
        gx = cv2.Sobel(g, cv2.CV_32F, 1, 0, 3)
        gy = cv2.Sobel(g, cv2.CV_32F, 0, 1, 3)
        mag = cv2.magnitude(gx, gy)
        thr = np.percentile(mag, 88)
        full = (mag >= thr).astype(np.uint8) * 255
        band25 = mm_to_px(ds, png_band_mm)
        y1, y2 = max(0, cy - band25), min(h, cy + band25)
        png_edges[y1:y2, :] = full[y1:y2, :]
        png_edges = cv2.bitwise_and(png_edges, body_cc)

    # HU+gradient ile duvar
    img8 = normalize8(hu, -200, 300)
    sob = gradient_mask_u8(img8, body_cc, CFG["GRAD_STRENGTH_BASE"])
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    wall0 = cv2.bitwise_or(muscle, sob)
    wall0 = cv2.bitwise_or(wall0, png_edges)
    wall0 = cv2.bitwise_and(wall0, body_cc)

    # kaba inner
    wall = cv2.morphologyEx(wall0, cv2.MORPH_CLOSE,
                            np.ones((2*mm_to_px(ds, 5)+1, )*2, np.uint8), 1)
    wall = cv2.dilate(wall, np.ones((2*mm_to_px(ds, 2)+1, )*2, np.uint8), 1)
    barrier = cv2.bitwise_or(wall, cv2.bitwise_not(body_cc))
    mask = np.zeros((h+2, w+2), np.uint8)
    tmp = (barrier == 0).astype(np.uint8) * 255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, (cx, cy), 128)
    inner = (tmp2 == 128).astype(np.uint8) * 255
    inner = cv2.bitwise_and(inner, body_cc)

    # aktif kontur rafinesi
    inner, wall_ref = refine_inner_with_active_contour(hu, inner, body_cc, vb, ds, png_edges=png_edges)

    # yükseklik bandı (L3 civarı)
    bandH = mm_to_px(ds, height_band_mm)
    y1, y2 = max(0, cy - bandH), min(h, cy + bandH)
    height_mask = np.zeros_like(inner); height_mask[y1:y2, :] = 255
    inner = cv2.bitwise_and(inner, height_mask)
    inner = cv2.morphologyEx(inner, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8), 1)
    return inner, wall_ref, vb, (cx, cy)

# =========================
# HU adaptasyonu / şekil skorları
# =========================
def adaptive_muscle_mask(hu, ring, base_range, fallback_range):
    vals = hu[ring > 0]
    vals = vals[(vals > fallback_range[0]) & (vals < fallback_range[1])]
    if vals.size >= 200:
        p10, p95 = np.percentile(vals, [10, 95])
        lo = max(fallback_range[0], min(base_range[0], p10 - 15))
        hi = min(fallback_range[1], max(base_range[1], p95 + 15))
        lo2 = max(fallback_range[0], min(lo, hi - 5))
        hi2 = min(fallback_range[1], max(hi, lo2 + 5))
        return hu_mask(hu, lo2, hi2), (float(lo2), float(hi2))
    return hu_mask(hu, *base_range), base_range

def shape_orientation_scores(comp_mask):
    m = (comp_mask > 0).astype(np.uint8)
    if cv2.countNonZero(m) == 0:
        return 0.0, 0.0, 0.0, 0.0
    cnts, _ = cv2.findContours(m, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return 0.0, 0.0, 0.0, 0.0
    cnt = max(cnts, key=cv2.contourArea)
    area = float(cv2.contourArea(cnt))
    hull = cv2.convexHull(cnt)
    hull_area = float(cv2.contourArea(hull)) + 1e-6
    convexity = max(0.0, min(1.0, area / hull_area))
    if len(cnt) >= 5:
        (_cx, _cy), (MA, ma), angle = cv2.fitEllipse(cnt)
        a = max(MA, ma) / 2.0
        b = max(1e-6, min(MA, ma) / 2.0)
        ecc = math.sqrt(max(0.0, 1.0 - (b*b)/(a*a)))
        axis_deg = float(angle)
    else:
        M = cv2.moments(cnt)
        if M["mu20"] + M["mu02"] == 0:
            ecc = 0.0; axis_deg = 0.0
        else:
            ang = 0.5 * math.atan2(2 * M["mu11"], (M["mu20"] - M["mu02"]))
            axis_deg = abs(np.degrees(ang))
            lam1 = (M["mu20"] + M["mu02"]) / 2 + math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            lam2 = (M["mu20"] + M["mu02"]) / 2 - math.sqrt(4*M["mu11"]**2 + (M["mu20"] - M["mu02"])**2)/2
            ecc = math.sqrt(max(0.0, 1.0 - (lam2+1e-6)/(lam1+1e-6)))
    # yataya yakınlık
    delta = min(abs(axis_deg - 0.0), abs(axis_deg - 180.0))
    axis_ok = 1.0 if delta <= CFG["PSOAS_AXIS_MAX_DEG"] else max(0.0, 1.0 - (delta - CFG["PSOAS_AXIS_MAX_DEG"])/CFG["PSOAS_AXIS_MAX_DEG"])
    ecc_ok = min(1.0, max(0.0, (ecc - CFG["PSOAS_SHAPE_MIN_ECC"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_ECC"] + 1e-6)))
    conv_ok = min(1.0, max(0.0, (convexity - CFG["PSOAS_SHAPE_MIN_CONVEXITY"]) / (1.0 - CFG["PSOAS_SHAPE_MIN_CONVEXITY"] + 1e-6)))
    shape_score = 0.45*ecc_ok + 0.25*conv_ok + 0.30*axis_ok
    return float(ecc), float(convexity), float(axis_ok*100.0), float(shape_score)

# =========================
# (YENİ) PSOAS Yardımcıları + Bulucu
# =========================
def posterior_exclusion_mask(hu_shape, vb, ds, angle_right=(0,90), angle_left=(90,180)):
    """Posterior 180–360°’yi kapat, sağ/sol sektörleri üret."""
    h, w = hu_shape
    cen = centroid(vb)
    if cen is None:
        cen = (w//2, h//2)
    cx, cy = cen
    yy, xx = np.mgrid[0:h, 0:w].astype(np.float32)
    dx, dy = xx - cx, cy - yy
    ang = (np.degrees(np.arctan2(dy, dx)) + 360.0) % 360.0
    R = ((ang >= angle_right[0]) & (ang <= angle_right[1])).astype(np.uint8)*255
    L = ((ang >= angle_left[0])  & (ang <= angle_left[1])).astype(np.uint8)*255
    POST = ((ang >= 180) & (ang < 360)).astype(np.uint8)*255
    return R, L, POST

def mediality_score(comp_mask, vb, ds, target_mm=10.0):
    inv_v = cv2.bitwise_not(vb)
    dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)
    md = float(dist[comp_mask > 0].mean()) if cv2.countNonZero(comp_mask) else 1e9
    tgt_px = mm_to_px(ds, target_mm)
    if md <= 0 or tgt_px <= 0:
        return 0.0, md
    sc = max(0.0, min(1.0, (tgt_px / (md + 1e-6))))
    return sc, md

def refine_small_active_contour(mask):
    if mask is None or cv2.countNonZero(mask) == 0:
        return mask
    k = np.ones((3,3), np.uint8)
    out = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k, iterations=1)
    out = cv2.morphologyEx(out,  cv2.MORPH_OPEN,  k, iterations=1)
    return out

def find_psoas_inside(hu, ds, inner, vertebra,
                      ring_inner_mm=6.0, ring_outer_mm=22.0,
                      grad_strength=0.85,
                      min_area_mm2=150.0, max_area_mm2=2000.0):
    """
    Vertebranın anteromedialinde, fasya İÇİNDE psoas arar:
    - Sağ: 0–90°, Sol: 90–180°
    - Posterior 180–360° tamamen dışlanır
    - Vertebraya yakınlık (mediality), HU, şekil ve eksen kısıtları
    """
    h, w = hu.shape
    cen = centroid(vertebra)
    if cen is None:
        return np.zeros_like(vertebra), {"reason": "vertebra_not_found"}
    cx, cy = int(cen[0]), int(cen[1])

    # Fasya içi halka
    i_px = mm_to_px(ds, ring_inner_mm)
    o_px = mm_to_px(ds, ring_outer_mm)
    dil_in  = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*i_px+1, 2*i_px+1)), 1)
    dil_out = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2*o_px+1, 2*o_px+1)), 1)
    ring = cv2.bitwise_and(cv2.subtract(dil_out, dil_in), inner)

    # Sektörler
    Rsec, Lsec, POST = posterior_exclusion_mask(hu.shape, vertebra, ds)
    ring = cv2.bitwise_and(ring, cv2.bitwise_not(POST))

    # Aday kas maskesi
    img8 = normalize8(hu, -200, 300)
    gmask  = gradient_mask_u8(img8, ring, grad_strength)
    muscle = hu_mask(hu, *CFG["HU_MUSCLE_BASE"])
    base = cv2.bitwise_and(muscle, ring)
    base = cv2.bitwise_and(base, gmask)

    # Kemik + vertebra buffer dışı
    bone_ex = hu_mask(hu, *CFG["HU_BONE_EXCLUDE"])
    vbuf = cv2.dilate(vertebra, cv2.getStructuringElement(cv2.MORPH_ELLIPSE,
                    (2*mm_to_px(ds, CFG["VERTEBRA_BUFFER_MM_BASE"])+1,)*2), 1)
    base = cv2.bitwise_and(base, cv2.bitwise_not(bone_ex))
    base = cv2.bitwise_and(base, cv2.bitwise_not(vbuf))

    # Sağ/sol adaylar
    R_cand = cv2.bitwise_and(base, Rsec)
    L_cand = cv2.bitwise_and(base, Lsec)

    # Alan sınırları
    min_px = area_px_from_mm2(ds, min_area_mm2)
    max_px = area_px_from_mm2(ds, max_area_mm2)

    def pick_best(cand_mask):
        m = (cand_mask > 0).astype(np.uint8)
        num, L, S, _ = cv2.connectedComponentsWithStats(m, 8)
        best = {"mask": None, "area": 0, "md": 1e9, "shape": -1, "stats": None, "score": -1.0,
                "ecc":0.0, "conv":0.0, "axis_pct":0.0}
        if num <= 1:
            return best

        inv_v = cv2.bitwise_not(vertebra)
        dist = cv2.distanceTransform(inv_v, cv2.DIST_L2, 3)

        for lbl in range(1, num):
            comp = (L == lbl).astype(np.uint8)
            a = int(S[lbl, cv2.CC_STAT_AREA])
            if a < min_px or a > max_px:
                continue

            vals = hu[comp > 0]
            mean_hu, std_hu = float(vals.mean()), float(vals.std())
            if not (-10 <= mean_hu <= 80 and std_hu >= 8.0):
                continue

            # Medial yakınlık
            med_sc, md = mediality_score(comp, vertebra, ds, target_mm=10.0)
            if md < mm_to_px(ds, 3.0):  # vertebraya yapışık olmasın
                continue

            # Şekil/eksen
            ecc, conv, axis_pct, shape_sc = shape_orientation_scores(comp)
            axis_ok = axis_pct/100.0
            if axis_ok <= 0.2:
                continue

            # HU stabilitesi (yumuşak kriter)
            hu_stab = min(1.0, std_hu/15.0) * 0.5 + (1.0 - abs(mean_hu-40)/80.0)*0.5
            hu_stab = max(0.0, min(1.0, hu_stab))

            score = 0.45*med_sc + 0.35*shape_sc + 0.20*hu_stab
            if score > best["score"]:
                best.update({
                    "mask": comp*255, "area": a, "md": md, "shape": shape_sc,
                    "stats": (mean_hu, std_hu), "score": score,
                    "ecc": ecc, "conv": conv, "axis_pct": axis_pct
                })

        if best["mask"] is not None:
            best["mask"] = refine_small_active_contour(best["mask"])
        return best

    Rbest = pick_best(R_cand)
    Lbest = pick_best(L_cand)

    psoas = np.zeros_like(vertebra)
    if Rbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Rbest["mask"])
    if Lbest["mask"] is not None:
        psoas = cv2.bitwise_or(psoas, Lbest["mask"])

    # Fasya içi ve vertebra buffer dışı garantisi
    psoas = cv2.bitwise_and(psoas, inner)
    psoas = cv2.bitwise_and(psoas, cv2.bitwise_not(vbuf))

    dbg = {
        "R_area_px": Rbest["area"], "L_area_px": Lbest["area"],
        "R_mean_dist": Rbest["md"], "L_mean_dist": Lbest["md"],
        "R_stats": Rbest["stats"], "L_stats": Lbest["stats"],
        "Rshape": Rbest["shape"], "Lshape": Lbest["shape"],
        "Rshape_dbg": (Rbest["ecc"], Rbest["conv"], Rbest["axis_pct"]),
        "Lshape_dbg": (Lbest["ecc"], Lbest["conv"], Lbest["axis_pct"]),
        "R_score": Rbest["score"], "L_score": Lbest["score"]
    }
    return psoas, dbg

# =========================
# Ölçüm / Overlay
# =========================
def vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=None):
    pxA = px_area_mm2(ds)
    lo, hi = (fat_range if fat_range else CFG["HU_FAT"])
    fat_mask = hu_mask(hu, lo, hi)
    vfa_px = int(np.count_nonzero(cv2.bitwise_and(fat_mask, inner)))
    pma_px = int(np.count_nonzero(psoas_mask))
    VFA_mm2 = vfa_px * pxA
    PMA_mm2 = pma_px * pxA
    return VFA_mm2, PMA_mm2

def build_overlay(hu, inner, vertebra, vfa_mask, psoas_mask):
    base = normalize8(hu, -200, 300)
    base = cv2.cvtColor(base, cv2.COLOR_GRAY2BGR)
    base[inner == 0] = (base[inner == 0] * 0.25).astype(np.uint8)
    # VFA: yeşil, Psoas: sarı, Vertebra: kırmızı
    for (m, col, al) in ((vfa_mask, (0,255,0), 0.35), (psoas_mask, (0,255,255), 0.55), (vertebra, (255,0,0), 0.35)):
        if m is None: continue
        m_in = cv2.bitwise_and(m, inner)
        a = ((m_in > 0).astype(np.float32)) * al
        colimg = np.full_like(base, col, np.uint8)
        base = (base * (1 - a[..., None]) + colimg * a[..., None]).astype(np.uint8)
    # kontur çiz
    for m, c in ((vfa_mask, (0,255,0)), (psoas_mask, (0,255,255))):
        m_in = cv2.bitwise_and(m, inner)
        cnts, _ = cv2.findContours((m_in > 0).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cv2.drawContours(base, cnts, -1, c, 2, lineType=cv2.LINE_AA)
    return base

# =========================
# Ana dış API
# =========================
def run_case(dcm_path: Path, height_cm: float, sex: str, png_path: Optional[Path] = None) -> Tuple[Metrics, Optional[np.ndarray]]:
    """
    GUI’nin çağırdığı tek giriş noktası.
    DICOM zorunlu, PNG opsiyonel (aynı kesitse registration faydalı).
    """
    dcm_path = Path(dcm_path)
    ds = pydicom.dcmread(str(dcm_path))
    hu = load_hu(ds)

    png_gray = None
    if png_path and Path(png_path).exists():
        png_gray = cv2.imread(str(png_path), cv2.IMREAD_GRAYSCALE)

    # Fasya içi alan + vertebra
    inner, wall_ref, vb, _ = inner_abdomen_via_wall(hu, ds, png_gray=png_gray, png_band_mm=25, height_band_mm=80)

    # Psoas (anteromedial, posterior dışlama)
    psoas_mask, _dbg = find_psoas_inside(
        hu, ds, inner, vb,
        ring_inner_mm=CFG["RING_INNER_MM_BASE"],
        ring_outer_mm=CFG["RING_OUTER_MM_BASE"],
        grad_strength=CFG["GRAD_STRENGTH_BASE"],
        min_area_mm2=CFG["MIN_PSOAS_AREA_MM2_BASE"],
        max_area_mm2=CFG["MAX_PSOAS_AREA_MM2_BASE"]
    )

    # VFA/PMA
    VFA_mm2, PMA_mm2 = vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=CFG["HU_FAT"])
    VFA_cm2 = VFA_mm2 / 100.0
    ratio = (VFA_mm2 / PMA_mm2) if PMA_mm2 > 0 else None
    height_m = height_cm / 100.0
    PMI = (PMA_mm2 / 100.0) / (height_m**2) if height_m > 0 else None

    vfa_high = int(VFA_cm2 >= CFG["VFA_OBESITY_CUTOFF_CM2"])
    sarcopenia = int((PMI is not None) and (PMI < CFG["PMI_CUTOFF"][sex.upper()]))
    so_flag = int(bool(sarcopenia) and ((ratio is not None and ratio >= CFG["VFA_PSOAS_RATIO_CUTOFF"]) or vfa_high))

    # Overlay
    vfa_mask = cv2.bitwise_and(hu_mask(hu, *CFG["HU_FAT"]), inner)
    overlay = build_overlay(hu, inner, vb, vfa_mask, psoas_mask)

    res = Metrics(
        case_id=dcm_path.stem,
        sex=sex.upper(),
        height_m=height_m,
        PMA_mm2=float(round(PMA_mm2, 1)),
        VFA_mm2=float(round(VFA_mm2, 1)),
        ratio_VFA_PMA=(float(round(ratio, 2)) if ratio is not None else None),
        PMI_cm2_per_m2=(float(round(PMI, 2)) if PMI is not None else None),
        vfa_high=int(vfa_high),
        sarcopenia_pmi=int(sarcopenia),
        so_flag=int(so_flag),
    )
    return res, overlay

def process_one(dicom_path, png_path, height_m, sex, use_png=True, fuse_neighbors=True):
    res = {}
    overlay = None
    """
    Güvenli şim: çekirdekte mevcut yardımcıları kullanarak tek dilim işleyip
    (opsiyonel olarak) komşu dilimleri fuse eder; overlay ve metrikleri döndürür.
    """
    import cv2, numpy as np, pydicom
    from pathlib import Path
    dcm_path = Path(dicom_path)
    if not dcm_path.exists():
        raise FileNotFoundError(f"DICOM bulunamadı: {dcm_path}")

    ds = pydicom.dcmread(str(dcm_path))
    hu = load_hu(ds)  # çekirdekte tanımlı olmalı

    png_gray = None
    if use_png and png_path:
        p = Path(png_path)
        if p.exists():
            png_gray = cv2.imread(str(p), cv2.IMREAD_GRAYSCALE)

    # Tek dilim çekirdek — çekirdekte tanımlı olmalı
    inner, vb, vfa_mask, psoas_mask, VFA_mm2, PMA_mm2, dbg, ranges, ray_qc = process_slice_core(
        hu, ds, png_gray, use_png, PNG_BAND_MM_BASE, HEIGHT_BAND_MM_BASE
    )

    # İsteğe bağlı komşu dilim füzyonu (varsa yardımcılar)
    VFA_list, PMA_list = [VFA_mm2], [PMA_mm2]
    if fuse_neighbors and 'neighbor_slices' in globals():
        try:
            for npath in neighbor_slices(dcm_path):
                dsn = pydicom.dcmread(str(npath))
                hun = load_hu(dsn)
                inner_n, vb_n, vfa_n, psoas_n, VFA_n, PMA_n, dbg_n, _ranges_n, _rq = process_slice_core(
                    hun, dsn, None, False, PNG_BAND_MM_BASE, HEIGHT_BAND_MM_BASE
                )
                VFA_list.append(VFA_n); PMA_list.append(PMA_n)
        except Exception as e:
            print("[WARN] neighbor fusion atlandı:", e)
        return res, overlay

    def _median_keep(vals):
        import numpy as np
        if 'tukey_filter' in globals():
            kept = tukey_filter(vals)
            return float(np.median(kept)) if kept else float(np.median(vals))
        return float(np.median(vals))

    VFA_mm2_f = _median_keep(VFA_list)
    PMA_mm2_f = _median_keep(PMA_list)

    # belirsizlik bandı (varsa)
    try:
        fat_range, muscle_range = ranges
        uncert = uncertainty_band(hu, ds, inner, psoas_mask, fat_range, muscle_range)
    except Exception:
        uncert = {"VFA_mm2_min": VFA_mm2_f, "VFA_mm2_max": VFA_mm2_f, "PMA_mm2_min": PMA_mm2_f, "PMA_mm2_max": PMA_mm2_f}

    # metrikler
    VFA_cm2 = VFA_mm2_f / 100.0
    ratio = (VFA_mm2_f / PMA_mm2_f) if PMA_mm2_f > 0 else None
    PMI = (PMA_mm2_f / 100.0) / (height_m**2) if height_m and height_m > 0 else None

    # eşikler — çekirdekte global değişkenler varsa onları kullan, yoksa default
    vfa_cut = globals().get('VFA_OBESITY_CUTOFF_CM2', 100)
    pmi_cut = globals().get('PMI_CUTOFF', {"M": 6.0, "F": 3.9}).get(sex, 6.0)
    ratio_cut = globals().get('VFA_PSOAS_RATIO_CUTOFF', 2.0)

    vfa_high = VFA_cm2 >= vfa_cut
    sarcopenia = (PMI is not None) and (PMI < pmi_cut)
    so_flag = int(sarcopenia and ((ratio is not None and ratio >= ratio_cut) or vfa_high))

    # L3 düzey kontrol (varsa)
    try:
        ok, l3_dbg = l3_level_check(hu, vb)
        l3_check = {"ok": int(ok), **l3_dbg}
    except Exception:
        l3_check = {"ok": 1}

    # overlay üret
    try:
        overlay = build_overlay(hu, inner, vb, vfa_mask, psoas_mask)
    except Exception:
        overlay = None

    # fasya QC bilgisi (varsa)
    fqc = ray_qc if isinstance(ray_qc, dict) else {}


    return res, overlay, parts


# =========================
# === process_slice_core SHIM (AO) ===
# =========================
def process_slice_core(hu, ds, png_gray, use_png, band25_mm, height_mm):
    """
    Öncelik: çekirdekteki gerçek fonksiyonları kullan.
    Yoksa minimal fallback ile tek dilim ölç:
      - İç (fasya içi) alan
      - Vertebra (kemik HU)
      - VFA: HU_FAT
      - PMA: vertebraya yakın kas HU (sağ/sol halka)
    Döndürür: inner, vb, vfa_mask, psoas_mask, VFA_mm2, PMA_mm2, dbg, (fat_range, muscle_range), ray_qc
    """
    import numpy as np, cv2, math

    # 1) Eğer çekirdekte ayrıntılı yol mevcutsa onu çağır
    if 'inner_abdomen_via_wall' in globals() and \
       'hu_adaptation' in globals() and \
       'find_psoas_inside' in globals() and \
       'vfa_pma_from_masks' in globals():
        inner, wall_ref, vb, cen, ray_qc = inner_abdomen_via_wall(
            hu, ds, png_gray if use_png else None, band25_mm, height_mm
        )
        (fat_range, muscle_range) = hu_adaptation(hu, inner, vb, ds)
        psoas_mask, dbg = find_psoas_inside(
            hu, ds, inner, vb,
            ring_inner_mm=globals().get('RING_INNER_MM_BASE', 6.0),
            ring_outer_mm=globals().get('RING_OUTER_MM_BASE', 20.0),
            grad_strength=globals().get('GRAD_STRENGTH_BASE', 0.85),
            min_area_mm2=globals().get('MIN_PSOAS_AREA_MM2_BASE', 150.0),
            max_area_mm2=globals().get('MAX_PSOAS_AREA_MM2_BASE', 2000.0)
        )
        vfa_mask = cv2.bitwise_and(hu_mask(hu, *fat_range), inner)
        VFA_mm2, PMA_mm2 = vfa_pma_from_masks(hu, ds, inner, psoas_mask, fat_range=fat_range)
        return inner, vb, vfa_mask, psoas_mask, VFA_mm2, PMA_mm2, dbg, (fat_range, muscle_range), (ray_qc if isinstance(ray_qc, dict) else {})

    # 2) Fallback (minimal) — çekirdek yardımcıları yoksa burası çalışır
    # Pixel alanı
    def _px_area_mm2(ds):
        sp = getattr(ds, "PixelSpacing", [1.0, 1.0])
        return float(sp[0]) * float(sp[1])

    # Basit gövde maskesi (fasya içi için başlangıç)
    img8 = np.clip(hu, -300, 300).astype(np.float32)
    img8 = cv2.normalize(img8, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)
    g = cv2.GaussianBlur(img8, (7,7), 0)
    thr_val, th = cv2.threshold(g, 0, 255, cv2.THRESH_BINARY+cv2.THRESH_OTSU)
    if np.mean(g[th>0]) < np.mean(g[th==0]):
        th = 255 - th
    body = cv2.morphologyEx(th, cv2.MORPH_CLOSE, np.ones((7,7), np.uint8), 2)
    body = cv2.morphologyEx(body, cv2.MORPH_OPEN,  np.ones((5,5), np.uint8), 1)

    # Vertebra: kemik HU (basit)
    HU_BONE = globals().get('HU_BONE_CAND', (150,2000))
    bone = ((hu >= HU_BONE[0]) & (hu <= HU_BONE[1])).astype(np.uint8)*255
    bone = cv2.morphologyEx(bone, cv2.MORPH_OPEN, np.ones((3,3), np.uint8), 1)
    num, L, S, C = cv2.connectedComponentsWithStats(bone, 8)
    vb = np.zeros_like(bone)
    if num > 1:
        h, w = hu.shape
        cx, cy = w//2, h//2
        best, sc = 0, -1e9
        for lbl in range(1, num):
            x,y,ww,hh,a = S[lbl]
            mx,my = C[lbl]
            dist = math.hypot(mx-cx, my-cy)
            per = cv2.arcLength(cv2.findContours((L==lbl).astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)[0][0], True) if True else 1.0
            circ = 1.0  # basit skor
            s = a - 3.0*dist + 2000.0*circ
            if s > sc:
                best, sc = lbl, s
        vb = (L==best).astype(np.uint8)*255

    # İç (fasya içi) maskeyi tahmin et: gövde içinde, vertebradan flood-fill
    h, w = hu.shape
    cen = (w//2, h//2)
    if cv2.countNonZero(vb)>0:
        M = cv2.moments(vb)
        if M["m00"]>0:
            cen = (int(M["m10"]/M["m00"]), int(M["m01"]/M["m00"]))
    barrier = cv2.bitwise_or(cv2.Canny(img8, 60, 120), cv2.bitwise_not(body))
    mask = np.zeros((h+2,w+2), np.uint8)
    tmp = (barrier==0).astype(np.uint8)*255
    tmp2 = tmp.copy()
    cv2.floodFill(tmp2, mask, cen, 128)
    inner = (tmp2==128).astype(np.uint8)*255
    inner = cv2.bitwise_and(inner, body)

    # Adaptif HU – yağ/kas aralığı
    vals = hu[inner>0]
    if vals.size>100:
        fat_lo = max(-250, np.percentile(vals, 10)-15)
        fat_hi = min(-20,  np.percentile(vals, 35)+15)
        fat_range = (max(globals().get('HU_FAT', (-190,-30))[0], fat_lo),
                     min(globals().get('HU_FAT', (-190,-30))[1], fat_hi))
    else:
        fat_range = globals().get('HU_FAT', (-190,-30))
    # kas: vertebraya yakın halka
    dil = cv2.dilate(vb, np.ones((15,15), np.uint8), 1)
    ring = cv2.subtract(cv2.dilate(dil, np.ones((35,35), np.uint8), 1), dil)
    ring = cv2.bitwise_and(ring, inner)
    mvals = hu[ring>0]
    if mvals.size>100:
        p10, p95 = np.percentile(mvals, [10,95])
        mlo = max(-60, min(-29, p10-15))
        mhi = min(200, max(150, p95+15))
        muscle_range = (mlo, mhi)
    else:
        muscle_range = globals().get('HU_MUSCLE_BASE', (-29,150))

    # VFA mask
    vfa_mask = cv2.bitwise_and(((hu>=fat_range[0])&(hu<=fat_range[1])).astype(np.uint8)*255, inner)

    # PMA: ring içinde kas HU + sağ/sol bölge
    yy, xx = np.mgrid[0:h,0:w].astype(np.float32)
    M = cv2.moments(vb) if cv2.countNonZero(vb)>0 else {"m00":0}
    if M["m00"]>0:
        cx, cy = M["m10"]/M["m00"], M["m01"]/M["m00"]
    else:
        cx, cy = w/2.0, h/2.0
    dx, dy = xx-cx, cy-yy
    ang = (np.degrees(np.arctan2(dy, dx))+360)%360
    Rs = ((ang>=0)&(ang<=90)).astype(np.uint8)*255
    Ls = ((ang>=90)&(ang<=180)).astype(np.uint8)*255
    muscle_mask = ((hu>=muscle_range[0])&(hu<=muscle_range[1])).astype(np.uint8)*255
    base = cv2.bitwise_and(muscle_mask, cv2.bitwise_and(ring, inner))
    R = cv2.bitwise_and(base, Rs)
    L = cv2.bitwise_and(base, Ls)
    psoas_mask = cv2.bitwise_or(R, L)

    # Alanlar
    pxA = _px_area_mm2(ds)
    VFA_mm2 = int(cv2.countNonZero(vfa_mask))*pxA
    PMA_mm2 = int(cv2.countNonZero(psoas_mask))*pxA

    dbg = {"fallback":"mini_core"}
    ray_qc = {}
    return inner, vb, vfa_mask, psoas_mask, float(VFA_mm2), float(PMA_mm2), dbg, (fat_range, muscle_range), ray_qc


# ===== AO DEBUG HELPERS =====
def _ao_dump_debug_masks(case_id, hu, inner, vfa_mask, psoas_mask, ds):
    try:
        import os, cv2, numpy as np
        outd = os.path.join(os.path.dirname(__file__), "DEBUG_OUT")
        os.makedirs(outd, exist_ok=True)
        base = normalize8(hu, -200, 300)
        cv2.imwrite(os.path.join(outd, f"{case_id}_base.png"), base)
        cv2.imwrite(os.path.join(outd, f"{case_id}_inner.png"), inner)
        cv2.imwrite(os.path.join(outd, f"{case_id}_vfa_mask.png"), vfa_mask)
        cv2.imwrite(os.path.join(outd, f"{case_id}_psoas_mask.png"), psoas_mask)
        # SFA: fasya-dışı yağ (yalnız debug)
        fat_range = globals().get('HU_FAT', (-190,-30))
        fat_mask = hu_mask(hu, *fat_range)
        sfa_mask = cv2.bitwise_and(fat_mask, cv2.bitwise_not(inner))
        cv2.imwrite(os.path.join(outd, f"{case_id}_sfa_mask.png"), sfa_mask)
    except Exception as e:
        print("[AO][DEBUG] dump hata:", e)
